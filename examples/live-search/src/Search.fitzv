// Fitz LiveViews — debounced live search (Phase 3c).
//
// Showcases the new live-input wiring:
//   @input="on_search"        → fires on every keystroke (data-flv-input)
//   data-flv-debounce="300"   → coalesce the burst; the socket sees one
//                               filtered re-render ~300ms after you stop typing
//
// Filtering runs server-side; the diff engine patches only the <ul>.

component Search {
  state {
    query: Str = ""
    items: List<Str> = ["apple", "apricot", "avocado", "banana", "blueberry", "cherry", "date", "fig", "grape", "kiwi", "lemon", "lime", "mango", "melon", "orange", "papaya", "peach", "pear", "plum", "raspberry"]
  }

  event on_search() { query = payload["value"] }

  <template>
    <div id="search-app" class="wrap">
      <h1>Live search</h1>
      <p class="hint">Type a fruit (lowercase). Debounced 300ms.</p>
      <input class="box" type="text" placeholder="type to filter…"
             @input="on_search" data-flv-debounce="300" value="{query}" />
      <ul class="results">
        {#for it in items}
          {#if it.contains(query)}
            <li class="item">{it}</li>
          {/if}
        {/for}
      </ul>
    </div>
  </template>

  <style scoped>
    .wrap { font-family: system-ui, sans-serif; max-width: 28rem; margin: 2rem auto; }
    .hint { color: var(--flv-text-muted, #55555c); font-size: .85rem; margin: 0 0 .8rem; }
    .box { width: 100%; padding: .6rem .8rem; font-size: 1rem; box-sizing: border-box;
           border: 1px solid var(--flv-border, #d9d9e0); border-radius: var(--flv-radius-md, 8px); }
    .results { list-style: none; padding: 0; margin: 1rem 0 0; }
    .item { padding: .4rem .2rem; border-bottom: 1px solid var(--flv-surface-2, #f5f5f7); }
  </style>
}
