// Fitz LiveViews — MetricTile SFC, refactored to the companion UI
// library (Phase 9.C). The counter body now composes packaged
// primitives: an `Icon` header, a `Badge` status, and `Button`s for
// the actions (the last two via thin helper fns in `metric_tile_ui.fitz`,
// since a struct literal inside a `{...}` template interpolation doesn't
// round-trip through the SSR emitter). Each `on_click` names a
// fall-through event routed to this component's `@on` handler.

from metric_tile_ui import live_badge, bump_button, reset_button
from fitz_liveviews.ui.icon import icon

component MetricTile {
  state { count: Int = 0 }

  event bump() { count = count + 1 }
  event reset() { count = 0 }

  <template>
    <div class="tile-body">
      <div class="tile-top">
        <span class="tile-ico">{icon("dashboard").raw}</span>
        {live_badge().raw}
      </div>
      <div class="tile-count">{count}</div>
      <div class="tile-buttons">
        {bump_button().raw}
        {reset_button().raw}
      </div>
    </div>
  </template>
}
