// ui-gallery — smoke for the companion UI library (Phase 9, corte 1).
//
// Validates that a host app pulls the generalized components straight from
// the package via dotted sub-path imports — `from fitz_liveviews.ui.<Comp>
// import ...` — instead of vendoring the `.fitzv` files. Renders each
// component to HTML and prints it, so `fitz run` exercises the whole
// resolution + SSR path without a WebSocket server.

// main.fitz is the entry file ([bin].main), so it imports `flv_register` plus
// the event handlers of every stateful component it pulls in — the implicit
// @live_component boot registrations need those names in scope to compile
// (pure-presentational components like Pager/Button/Badge/Spinner only need
// `flv_register`). A `fitz run` renders each component to stdout.
from fitz_liveviews import flv_register
from fitz_liveviews.ui.Pager import pager, pager_render
from fitz_liveviews.ui.Toast import toast, toast_render, toast_show, toast_dismiss
from fitz_liveviews.ui.ConfirmDialog import confirm_dialog, confirm_dialog_render, confirm_dialog_ask, confirm_dialog_cancel
from fitz_liveviews.ui.theme import ui_theme
from fitz_liveviews.ui.Button import button, button_render
from fitz_liveviews.ui.Badge import badge, badge_render
from fitz_liveviews.ui.Spinner import spinner, spinner_render
from fitz_liveviews.ui.icon import icon
from fitz_liveviews.ui.Card import card, card_render
from fitz_liveviews.ui.Alert import alert, alert_render
from fitz_liveviews.ui.Input import input, input_render
from fitz_liveviews.ui.Modal import modal, modal_render, modal_show, modal_close
from fitz_liveviews.ui.ThemeToggle import theme_toggle, theme_toggle_render
from fitz_liveviews.ui.theme_scripts import theme_boot_script, theme_cycle_script
from fitz_liveviews.ui.DataGrid import data_grid, data_grid_render
from fitz_liveviews.ui.SortableHeader import sortable_header, sortable_header_render
from fitz_liveviews.ui.GridToolbar import grid_toolbar, grid_toolbar_render
from fitz_liveviews.ui.GridFilters import grid_filters, grid_filters_render
from fitz_liveviews.ui.grid_helpers import Pill, sort_arrow

print("=== Theme tokens ===")
print(ui_theme().raw)

print("=== Pager (page 2 of 5) ===")
let pager_html = pager_render(pager { page: 2, total_pages: 5 })
print(pager_html.raw)

print("=== Toast (success) ===")
let toast_html = toast_render(toast { open: true, message: "Guardado", kind: "success" })
print(toast_html.raw)

print("=== ConfirmDialog (open) ===")
let cd_html = confirm_dialog_render(confirm_dialog {
  open: true,
  ids: "1,2,3",
  message: "¿Eliminar 3 empleados?",
  title: "Confirmar borrado",
  cancel_label: "Cancelar",
  confirm_label: "Eliminar"
})
print(cd_html.raw)

print("=== Button (primary) ===")
print(button_render(button { label: "Guardar", variant: "primary", on_click: "save" }).raw)

print("=== Button (danger, loading) ===")
print(button_render(button { label: "Eliminando", variant: "danger", on_click: "del", loading: true }).raw)

print("=== Button (ghost, disabled) ===")
print(button_render(button { label: "Sin permiso", variant: "ghost", on_click: "noop", disabled: true }).raw)

print("=== Button (submit — drives an enclosing form) ===")
print(button_render(button { label: "Enviar", variant: "primary", submit: true }).raw)

print("=== Button (icon + label) ===")
print(button_render(button { label: "Agregar", icon: "plus", variant: "primary", on_click: "add" }).raw)

print("=== Button (icon-only + tooltip + value payload) ===")
print(button_render(button { icon: "trash", variant: "ghost", size: "sm", on_click: "delete_row", value: "42", tooltip: "Eliminar", aria_label: "Eliminar" }).raw)

print("=== Badge (success) ===")
print(badge_render(badge { label: "activo", variant: "success" }).raw)

print("=== Badge (count, primary, sm) ===")
print(badge_render(badge { label: "12", variant: "primary", size: "sm" }).raw)

print("=== Spinner (indeterminate, md) ===")
print(spinner_render(spinner { size: "md", label: "Cargando" }).raw)

print("=== Spinner (determinate 65%) ===")
print(spinner_render(spinner { size: "lg", progress: 65, label: "65 por ciento" }).raw)

print("=== Icon (check) ===")
print(icon("check").raw)

print("=== Icon (unknown → empty svg) ===")
print(icon("nope").raw)

print("=== Card (title + raw body + footer, elevation md) ===")
print(card_render(card {
  title: "Perfil",
  body: "<p>Contenido <strong>rico</strong> en HTML</p>",
  footer: "<small>Actualizado hoy</small>",
  elevation: "md"
}).raw)

print("=== Alert (warning, dismissible) ===")
print(alert_render(alert {
  variant: "warning",
  title: "Atención",
  body: "El disco está casi lleno.",
  dismissible: true,
  on_dismiss: "dismiss_alert"
}).raw)

print("=== Input (with error) ===")
print(input_render(input {
  name: "email",
  label: "Correo",
  value: "no-es-un-mail",
  input_type: "email",
  placeholder: "vos@ejemplo.com",
  error: "Correo inválido"
}).raw)

print("=== Input (with hint, disabled) ===")
print(input_render(input {
  name: "user",
  label: "Usuario",
  value: "ada",
  hint: "No se puede cambiar",
  disabled: true
}).raw)

print("=== Input (live form — required + clear) ===")
print(input_render(input {
  name: "message",
  placeholder: "Escribí un mensaje",
  required: true,
  clear: true,
  autocomplete: "off"
}).raw)

print("=== Modal (open) ===")
print(modal_render(modal {
  open: true,
  title: "Editar empleado",
  body: "<p>Formulario acá</p>"
}).raw)

print("=== ThemeToggle button ===")
print(theme_toggle_render(theme_toggle { label: "🖥️ Auto", aria_label: "Tema" }).raw)

print("=== Theme boot script (goes in <head>) ===")
print(theme_boot_script("flv-gallery-theme").raw)

print("=== Theme cycle script (goes before </body>) ===")
print(theme_cycle_script("flv-gallery-theme", "☀️ Claro", "🌙 Oscuro", "🖥️ Auto").raw)

// === DataGrid family (Session E) ===

print("=== SortableHeader (active, ascending) ===")
print(sortable_header_render(sortable_header { label: "Nombre", col: "nombre", active_col: "nombre", dir: "asc" }).raw)

print("=== SortableHeader (inactive, no arrow) ===")
print(sortable_header_render(sortable_header { label: "Email", col: "email", active_col: "nombre", dir: "asc" }).raw)

print("=== GridToolbar (search + clear + actions) ===")
print(grid_toolbar_render(grid_toolbar {
  q: "ada",
  placeholder: "Buscar…",
  search_label: "Buscar",
  clear_label: "Limpiar",
  actions: "<button class=\"btn-primary\">+ Nuevo</button>"
}).raw)

print("=== GridFilters (estado pills — distinct events) ===")
let estado_pills: List<Pill> = [
  Pill { label: "Todos", event: "estado_all", active: true },
  Pill { label: "Activos", event: "estado_active" },
  Pill { label: "Inactivos", event: "estado_inactive" },
]
print(grid_filters_render(grid_filters { pills: estado_pills, filter_label: "Estado" }).raw)

print("=== GridFilters (depto pills — one event + value payload) ===")
let depto_pills: List<Pill> = [
  Pill { label: "Todos", event: "filter_depto", value: "0", active: true },
  Pill { label: "Ingeniería", event: "filter_depto", value: "1" },
  Pill { label: "Ventas", event: "filter_depto", value: "2" },
]
print(grid_filters_render(grid_filters { pills: depto_pills, filter_label: "Departamento" }).raw)

print("=== DataGrid (head + body + info + pager foot) ===")
let dg_head = "<tr>" + sortable_header_render(sortable_header { label: "ID", col: "id", cls: "col-id", active_col: "id", dir: "asc" }).raw + sortable_header_render(sortable_header { label: "Nombre", col: "nombre", active_col: "id", dir: "asc" }).raw + "<th>Estado</th></tr>"
let dg_body = "<tr data-flv-key=\"r-1\"><td data-label=\"ID\" class=\"col-id\">1</td><td data-label=\"Nombre\"><strong>Ada</strong></td><td data-label=\"Estado\"><span class=\"badge badge-ok\">Activo</span></td></tr>"
print(data_grid_render(data_grid {
  head: dg_head,
  body: dg_body,
  info: "Página 1 de 1",
  foot: "<div class=\"pager\"></div>",
  cols: 3
}).raw)

print("=== DataGrid (empty state) ===")
print(data_grid_render(data_grid {
  head: dg_head,
  body: "",
  empty: "No hay empleados",
  info: "0 empleados",
  cols: 3
}).raw)
