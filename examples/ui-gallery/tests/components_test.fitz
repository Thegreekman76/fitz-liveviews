from fitz_liveviews.ui.Card import card, card_render
from fitz_liveviews.ui.Alert import alert, alert_render
from fitz_liveviews.ui.Input import input, input_render
from fitz_liveviews.ui.Modal import modal, modal_render, modal_show, modal_close
from fitz_liveviews.ui.Breadcrumbs import breadcrumbs, breadcrumbs_render
from fitz_liveviews.ui.shell_types import Crumb, NavItem, NavGroup
from fitz_liveviews.ui.ThemeToggle import theme_toggle, theme_toggle_render
from fitz_liveviews.ui.theme_scripts import theme_boot_script, theme_cycle_script
from fitz_liveviews.ui.Sidebar import sidebar_render
from fitz_liveviews.ui.Topbar import topbar_render, initials_of
from fitz_liveviews.ui.AppShell import app_shell, ui_shell_css, shell_behavior_script
from fitz_liveviews.ui.StatCard import stat_card, stat_card_render
from fitz_liveviews.ui.BarChart import bar_chart, bar_chart_render
from fitz_liveviews.ui.ProgressBar import progress_bar, progress_bar_render
from fitz_liveviews.ui.chart_helpers import Bar, bar_scale, pct_of
from fitz_liveviews.ui.DataGrid import data_grid, data_grid_render
from fitz_liveviews.ui.SortableHeader import sortable_header, sortable_header_render
from fitz_liveviews.ui.GridToolbar import grid_toolbar, grid_toolbar_render
from fitz_liveviews.ui.GridFilters import grid_filters, grid_filters_render
from fitz_liveviews.ui.grid_helpers import Pill, sort_arrow
from fitz_liveviews.ui.Textarea import textarea, textarea_render
from fitz_liveviews.ui.Select import select, select_render
from fitz_liveviews.ui.Checkbox import checkbox, checkbox_render
from fitz_liveviews.ui.CheckboxGroup import checkbox_group, checkbox_group_render
from fitz_liveviews.ui.RadioGroup import radio_group, radio_group_render
from fitz_liveviews.ui.Rating import rating, rating_render
from fitz_liveviews.ui.DatePicker import date_picker, date_picker_render
from fitz_liveviews.ui.form_input_helpers import FieldOption, rating_stars
from fitz_liveviews.ui.FormLayout import form_layout, form_layout_render
from fitz_liveviews.ui.FormRow import form_row, form_row_render
from fitz_liveviews.ui.GroupSelect import group_select, group_select_render
from fitz_liveviews.ui.MultiSelect import multi_select, multi_select_render
from fitz_liveviews.ui.Tabs import tabs, tabs_render
from fitz_liveviews.ui.Stepper import stepper, stepper_render
from fitz_liveviews.ui.TreeView import tree_view, tree_view_render
from fitz_liveviews.ui.form_layout_helpers import OptionGroup, Tab, Step, TreeNode, tree_arrow
from fitz_liveviews.ui.Chip import chip, chip_render
from fitz_liveviews.ui.CountBadge import count_badge, count_badge_render
from fitz_liveviews.ui.Tooltip import tooltip, tooltip_render
from fitz_liveviews.ui.Divider import divider, divider_render
from fitz_liveviews.ui.ExpansionPanel import expansion_panel, expansion_panel_render
from fitz_liveviews import html

// --- Pager (presentational / controlled) ---

@test fn pager_marks_the_current_page_active() {
    let h = pager_render(pager { page: 2, total_pages: 5 }).raw
    assert(h.contains("pg-active"))
    // every page number 1..total_pages is a button
    assert(h.contains("data-flv-value-page=\"5\""))
}

@test fn pager_disables_prev_on_first_page() {
    let h = pager_render(pager { page: 1, total_pages: 3 }).raw
    // prev is a disabled button; next is an active fall-through event
    assert(h.contains("disabled"))
    assert(h.contains("data-flv-click=\"page_next\""))
}

@test fn pager_single_page_disables_both_arrows() {
    let h = pager_render(pager { page: 1, total_pages: 1 }).raw
    assert(not h.contains("data-flv-click=\"page_prev\""))
    assert(not h.contains("data-flv-click=\"page_next\""))
}

// --- Toast (stateful, transient) ---

@test fn toast_closed_by_default_renders_nothing() {
    let h = toast_render(toast { }).raw
    // the scoped <style> block always renders (it names data-kind in its
    // selectors), so key on the dismiss button, which lives inside {#if open}
    assert(not h.contains("data-flv-click=\"dismiss\""))
}

@test fn toast_show_opens_with_message_and_kind() {
    let t = toast_show(toast { }, { "message": "Saved", "kind": "error" })
    assert_eq(t.open, true)
    assert_eq(t.message, "Saved")
    assert_eq(t.kind, "error")
    let h = toast_render(t).raw
    assert(h.contains("Saved"))
    assert(h.contains("data-kind=\"error\""))
}

@test fn toast_dismiss_closes_and_clears_message() {
    let opened = toast_show(toast { }, { "message": "Hi", "kind": "success" })
    let closed = toast_dismiss(opened, { })
    assert_eq(closed.open, false)
    assert_eq(closed.message, "")
}

// --- ConfirmDialog (stateful) ---

@test fn confirm_dialog_closed_by_default() {
    let h = confirm_dialog_render(confirm_dialog { }).raw
    // the scoped <style> names .cd-overlay in its selectors, so key on the
    // cancel button, which only renders inside {#if open}
    assert(not h.contains("data-flv-click=\"cancel\""))
}

@test fn confirm_dialog_ask_opens_with_seeded_labels_and_message() {
    let d = confirm_dialog_ask(
        confirm_dialog { title: "Delete?", cancel_label: "No", confirm_label: "Yes" },
        { "ids": "1,2,3", "message": "Delete 3 items?" }
    )
    assert_eq(d.open, true)
    assert_eq(d.ids, "1,2,3")
    let h = confirm_dialog_render(d).raw
    assert(h.contains("cd-overlay"))
    assert(h.contains("Delete 3 items?"))
    assert(h.contains("Yes"))
    // the confirm button fires an event the component does NOT declare,
    // so it falls through to the host loop
    assert(h.contains("data-flv-click=\"confirm_delete\""))
}

@test fn confirm_dialog_cancel_closes_and_clears_ids() {
    let opened = confirm_dialog_ask(confirm_dialog { }, { "ids": "9", "message": "x" })
    let closed = confirm_dialog_cancel(opened, { })
    assert_eq(closed.open, false)
    assert_eq(closed.ids, "")
}

// --- theme ---

@test fn ui_theme_emits_flv_tokens_and_dark_override() {
    let css = ui_theme().raw
    assert(css.contains("--flv-color-primary"))
    assert(css.contains("--flv-surface"))
    assert(css.contains("data-theme=\"dark\""))
}

// --- ThemeToggle + theme scripts (Shell family, part 2) ---

@test fn theme_toggle_renders_button_wired_to_cycle() {
    // presentational, no events: the click runs the client-side flvCycleTheme,
    // never a WS event. The id must match what theme_cycle_script paints.
    let h = theme_toggle_render(theme_toggle { label: "🖥️ Auto", aria_label: "Tema" }).raw
    assert(h.contains("id=\"flv-theme-btn\""))
    assert(h.contains("onclick=\"flvCycleTheme()\""))
    assert(h.contains("aria-label=\"Tema\""))
    assert(h.contains("🖥️ Auto"))
    // it's a client-side toggle, so it never emits a fall-through WS event
    assert(not h.contains("data-flv-click"))
}

@test fn theme_boot_script_reads_storage_key_and_sets_data_theme() {
    let s = theme_boot_script("flv-admin-theme").raw
    assert(s.contains("<script>"))
    assert(s.contains("localStorage.getItem('flv-admin-theme')"))
    assert(s.contains("setAttribute('data-theme'"))
}

@test fn theme_cycle_script_defines_global_and_embeds_labels() {
    let s = theme_cycle_script("flv-admin-theme", "☀️ Claro", "🌙 Oscuro", "🖥️ Auto").raw
    assert(s.contains("window.flvCycleTheme"))
    // paints the button the ThemeToggle component renders
    assert(s.contains("flv-theme-btn"))
    assert(s.contains("localStorage.setItem('flv-admin-theme'"))
    // the labels are baked into the LABELS map
    assert(s.contains("☀️ Claro"))
    assert(s.contains("🌙 Oscuro"))
}

// === corte 2 — presentational primitives (Button / Badge / Spinner / Icon) ===
// These have no state and no events: the render fn maps props -> Html. Because
// the scoped <style> block always emits every selector, "absence" tests key on
// markup that only appears in the rendered element (e.g. `disabled=""`, or a
// space-joined class list `flv-btn-spin flv-btn-spin-`), never on class names.

// --- Button ---

@test fn button_primary_is_clickable_and_not_disabled() {
    let h = button_render(button { label: "Guardar", variant: "primary", on_click: "save" }).raw
    assert(h.contains("data-flv-click=\"save\""))
    assert(h.contains("data-variant=\"primary\""))
    assert(h.contains("Guardar"))
    assert(not h.contains("disabled=\"\""))
}

@test fn button_loading_is_disabled_and_shows_spinner() {
    let h = button_render(button { label: "x", on_click: "e", loading: true }).raw
    assert(h.contains("disabled=\"\""))
    // the spinner <span> is HTML-only (the CSS names `.flv-btn-spin-...`, not
    // the space-joined `flv-btn-spin flv-btn-spin-` that the class attr emits)
    assert(h.contains("flv-btn-spin flv-btn-spin-"))
}

@test fn button_disabled_blocks_click_without_spinner() {
    let h = button_render(button { label: "x", on_click: "e", disabled: true }).raw
    assert(h.contains("disabled=\"\""))
    assert(not h.contains("flv-btn-spin flv-btn-spin-"))
}

@test fn button_default_is_type_button_not_form_submit() {
    // a plain action button never submits a form it sits inside
    let h = button_render(button { label: "x", on_click: "e" }).raw
    assert(h.contains("type=\"button\""))
    assert(not h.contains("type=\"submit\""))
}

@test fn button_submit_is_type_submit_without_flv_click() {
    // a submit button drives an enclosing <form data-flv-submit>, so it
    // renders type="submit" and omits its own data-flv-click event
    let h = button_render(button { label: "Send", variant: "primary", submit: true }).raw
    assert(h.contains("type=\"submit\""))
    assert(not h.contains("data-flv-click"))
    assert(h.contains("Send"))
}

@test fn button_icon_renders_svg_before_label() {
    // icon + label: the SVG (from the icon set) sits ahead of the label span
    let h = button_render(button { label: "Agregar", icon: "plus", on_click: "add" }).raw
    assert(h.contains("<svg"))
    assert(h.contains("Agregar"))
    assert(h.contains("flv-btn-label"))
}

@test fn button_icon_only_omits_label_and_carries_aria_label() {
    // no label prop -> icon-only button, named for AT via aria-label
    let h = button_render(button { icon: "trash", variant: "ghost", size: "sm", on_click: "del", aria_label: "Eliminar" }).raw
    assert(h.contains("<svg"))
    assert(h.contains("aria-label=\"Eliminar\""))
    assert(not h.contains("flv-btn-label"))
}

@test fn button_value_emits_click_payload() {
    // a fall-through click carries data-flv-value-value so the loop reads payload["value"]
    let h = button_render(button { icon: "edit", on_click: "edit_row", value: "42" }).raw
    assert(h.contains("data-flv-value-value=\"42\""))
    assert(h.contains("data-flv-click=\"edit_row\""))
}

@test fn button_tooltip_is_emitted() {
    let h = button_render(button { icon: "trash", on_click: "del", tooltip: "Eliminar" }).raw
    assert(h.contains("data-tooltip=\"Eliminar\""))
}

@test fn button_submit_omits_value_payload() {
    // submit buttons drive a form, not a click event, so they carry no payload attr
    let h = button_render(button { label: "Send", submit: true, value: "9" }).raw
    assert(h.contains("type=\"submit\""))
    assert(not h.contains("data-flv-value-value"))
}

// --- Badge ---

@test fn badge_renders_label_variant_and_size() {
    let h = badge_render(badge { label: "activo", variant: "success", size: "sm" }).raw
    assert(h.contains("data-variant=\"success\""))
    assert(h.contains("data-size=\"sm\""))
    assert(h.contains(">activo</span>"))
}

@test fn badge_defaults_to_muted_md() {
    let h = badge_render(badge { label: "7" }).raw
    assert(h.contains("data-variant=\"muted\""))
    assert(h.contains("data-size=\"md\""))
}

// --- Spinner ---

@test fn spinner_indeterminate_renders_ring_no_svg() {
    let h = spinner_render(spinner { size: "md", label: "Cargando" }).raw
    assert(h.contains("flv-spin-ring flv-spin-ring-"))
    assert(not h.contains("<svg"))
    assert(h.contains("Cargando"))
}

@test fn spinner_determinate_renders_svg_and_percent_var() {
    let h = spinner_render(spinner { size: "lg", progress: 65, label: "x" }).raw
    assert(h.contains("<svg"))
    assert(h.contains("style=\"--flv-p: 65\""))
    assert(h.contains("data-size=\"lg\""))
}

@test fn spinner_inline_sets_data_inline_true() {
    let h = spinner_render(spinner { inline: true }).raw
    assert(h.contains("data-inline=\"true\""))
}

// --- Icon ---

@test fn icon_known_renders_svg_with_currentcolor() {
    let h = icon("check").raw
    assert(h.contains("<svg"))
    assert(h.contains("stroke=\"currentColor\""))
    assert(h.contains("<polyline points=\"20 6 9 17 4 12\""))
}

@test fn icon_unknown_renders_empty_svg() {
    let h = icon("does-not-exist").raw
    assert(h.contains("<svg"))
    // empty body: the <svg> closes right after its class attribute
    assert(h.contains("class=\"flv-icon\"></svg>"))
}

// === corte 2 — Card / Alert / Input (presentational) + Modal (stateful) ===

// --- Card ---

@test fn card_renders_title_raw_body_and_footer() {
    let h = card_render(card {
        title: "Perfil", body: "<p>rico</p>", footer: "<small>pie</small>", elevation: "md"
    }).raw
    assert(h.contains("data-elevation=\"md\""))
    assert(h.contains(">Perfil</div>"))
    assert(h.contains("<p>rico</p>"))         // body is RAW
    assert(h.contains("<small>pie</small>"))  // footer is RAW
}

@test fn card_omits_head_and_foot_when_empty() {
    let h = card_render(card { body: "<p>x</p>" }).raw
    // HTML-only markers (the CSS names `.flv-card-head-...`, not the
    // space-joined class attr the element would emit)
    assert(not h.contains("flv-card-head flv-card-head-"))
    assert(not h.contains("flv-card-foot flv-card-foot-"))
}

@test fn card_clickable_fires_on_click() {
    let h = card_render(card { body: "x", clickable: true, on_click: "open_row" }).raw
    assert(h.contains("data-flv-click=\"open_row\""))
}

@test fn card_default_is_not_clickable() {
    let h = card_render(card { body: "x" }).raw
    assert(not h.contains("data-flv-click"))
}

// --- Alert ---

@test fn alert_renders_variant_title_and_body() {
    let h = alert_render(alert { variant: "warning", title: "Atención", body: "casi lleno" }).raw
    assert(h.contains("data-variant=\"warning\""))
    assert(h.contains(">Atención</div>"))
    assert(h.contains(">casi lleno</div>"))
}

@test fn alert_body_is_escaped() {
    let h = alert_render(alert { body: "<script>x</script>" }).raw
    assert(h.contains("&lt;script&gt;"))
    assert(not h.contains("<script>"))
}

@test fn alert_dismissible_shows_close_button() {
    let h = alert_render(alert { body: "x", dismissible: true, on_dismiss: "hide" }).raw
    assert(h.contains("data-flv-click=\"hide\""))
}

@test fn alert_not_dismissible_omits_close_button() {
    let h = alert_render(alert { body: "x" }).raw
    assert(not h.contains("data-flv-click"))
}

// --- Input ---

@test fn input_renders_name_value_type_and_label() {
    let h = input_render(input { name: "email", label: "Correo", value: "a@b.co", input_type: "email" }).raw
    assert(h.contains("name=\"email\""))
    assert(h.contains("type=\"email\""))
    assert(h.contains("value=\"a@b.co\""))
    assert(h.contains(">Correo</span>"))
}

@test fn input_error_shows_error_and_hides_hint() {
    let h = input_render(input { name: "x", error: "requerido", hint: "pista" }).raw
    assert(h.contains("flv-field-error flv-field-error-"))  // HTML-only marker
    assert(h.contains("requerido"))
    assert(not h.contains("pista"))
}

@test fn input_hint_shows_when_no_error() {
    let h = input_render(input { name: "x", hint: "pista" }).raw
    assert(h.contains("pista"))
    assert(not h.contains("flv-field-error flv-field-error-"))
}

@test fn input_escapes_value_attribute() {
    let h = input_render(input { name: "x", value: "\"><img>" }).raw
    assert(h.contains("&quot;&gt;&lt;img&gt;"))
    assert(not h.contains("value=\"\"><img>"))
}

@test fn input_disabled_renders_disabled_attr() {
    let h = input_render(input { name: "x", disabled: true }).raw
    assert(h.contains("disabled=\"\""))
}

@test fn input_required_and_clear_emit_live_form_attrs() {
    // a live-form field: required for client validation, data-flv-clear so the
    // client empties it after each successful submit
    let h = input_render(input { name: "msg", required: true, clear: true }).raw
    assert(h.contains("required"))
    assert(h.contains("data-flv-clear"))
}

@test fn input_autocomplete_is_passed_through() {
    let h = input_render(input { name: "msg", autocomplete: "off" }).raw
    assert(h.contains("autocomplete=\"off\""))
}

// --- Modal (stateful) ---

@test fn modal_closed_by_default_renders_nothing() {
    // the scoped <style> always renders; key on the close control inside {#if open}
    let h = modal_render(modal { }).raw
    assert(not h.contains("data-flv-click=\"close\""))
}

@test fn modal_show_opens_with_title_and_body_from_payload() {
    let m = modal_show(modal { }, { "title": "Editar", "body": "<p>form</p>" })
    assert_eq(m.open, true)
    assert_eq(m.title, "Editar")
    let h = modal_render(m).raw
    assert(h.contains("data-flv-click=\"close\""))
    assert(h.contains(">Editar</h3>"))
    assert(h.contains("<p>form</p>"))  // body is RAW
}

@test fn modal_close_closes_and_clears_body() {
    let opened = modal_show(modal { }, { "title": "x", "body": "y" })
    let closed = modal_close(opened, { })
    assert_eq(closed.open, false)
    assert_eq(closed.body, "")
}

// --- Breadcrumbs (presentational / controlled, Shell family) ---

@test fn breadcrumbs_renders_links_and_current() {
    let cs: List<Crumb> = [
        Crumb { label: "Home", href: "/" },
        Crumb { label: "Users", href: "/users" },
        Crumb { label: "Ada", href: "" },
    ]
    let h = breadcrumbs_render(breadcrumbs { items: cs }).raw
    // Linked crumbs render as <a href>; the current (href == "") as a span.
    assert(h.contains("href=\"/\""))
    assert(h.contains("href=\"/users\""))
    assert(h.contains("aria-current=\"page\""))
    assert(h.contains("Ada"))
    // The current crumb is NOT a link (no empty href leaks through).
    assert(not h.contains("href=\"\""))
}

@test fn breadcrumbs_escapes_labels() {
    let cs: List<Crumb> = [Crumb { label: "<b>x</b>", href: "" }]
    let h = breadcrumbs_render(breadcrumbs { items: cs }).raw
    assert(h.contains("&lt;b&gt;"))
}

@test fn breadcrumbs_empty_is_just_the_nav() {
    let cs: List<Crumb> = []
    let h = breadcrumbs_render(breadcrumbs { items: cs }).raw
    // The <nav> renders; with no items there are no link/current elements. The
    // scoped <style> always emits (it names the classes), so key on the markup
    // that only appears per-item: an <a> tag and aria-current.
    assert(h.contains("flv-breadcrumbs"))
    assert(not h.contains("<a "))
    assert(not h.contains("aria-current"))
}

@test fn breadcrumbs_sets_aria_label() {
    let cs: List<Crumb> = [Crumb { label: "Home", href: "" }]
    let h = breadcrumbs_render(breadcrumbs { items: cs, aria_label: "Migas" }).raw
    assert(h.contains("aria-label=\"Migas\""))
}

// === Shell family, part 3 — Sidebar / Topbar / AppShell ===
// Plain render helpers (not .fitzv): they compose document/HTML strings from a
// nav data model + already-rendered pieces. Tested like the other components:
// the rendered HTML/CSS is asserted on substrings.

// --- Sidebar (nav model → left rail) ---

// A small nav model reused by the sidebar tests.
fn sample_nav() -> List<NavGroup> {
    return [
        NavGroup {
            items: [NavItem { href: "/", label: "Dashboard", key: "dashboard", icon: "📊" }],
        },
        NavGroup {
            label: "Organización",
            icon: "🗂️",
            items: [
                NavItem { href: "/empleados", label: "Empleados", key: "empleados", icon: "👥" },
                NavItem { href: "/departamentos", label: "Deptos", key: "departamentos", icon: "🏢" },
            ],
        },
    ]
}

@test fn sidebar_renders_brand_flat_link_and_active_item() {
    let h = sidebar_render("Fitz Admin", "▲", sample_nav(), "empleados", "Personas").raw
    assert(h.contains("<aside class=\"sidebar\">"))
    assert(h.contains("brand-mark"))
    assert(h.contains("Fitz Admin"))
    // flat top-level link (label == "" group → plain nav-item, no <details>)
    assert(h.contains("href=\"/\""))
    assert(h.contains("Dashboard"))
    // leaf links close the mobile drawer on click
    assert(h.contains("onclick=\"flvCloseDrawer()\""))
    // the active screen's item gets `.active`
    assert(h.contains("nav-item active"))
    // the footer line
    assert(h.contains("Personas"))
}

@test fn sidebar_group_auto_opens_when_a_child_is_active() {
    // "empleados" is inside the "Organización" group → the <details> opens.
    let h = sidebar_render("A", "▲", sample_nav(), "empleados", "F").raw
    assert(h.contains("<details class=\"nav-group\" open>"))
    assert(h.contains("nav-group-head"))
}

@test fn sidebar_group_stays_closed_when_no_child_is_active() {
    // "dashboard" is a flat item, so the "Organización" group has no active child.
    let h = sidebar_render("A", "▲", sample_nav(), "dashboard", "F").raw
    assert(h.contains("<details class=\"nav-group\">"))
    assert(not h.contains("<details class=\"nav-group\" open>"))
}

@test fn sidebar_escapes_labels_and_brand() {
    let nav: List<NavGroup> = [
        NavGroup { items: [NavItem { href: "/x", label: "<b>x</b>", key: "x" }] },
    ]
    let h = sidebar_render("<i>A</i>", "▲", nav, "none", "<u>f</u>").raw
    assert(h.contains("&lt;b&gt;"))   // item label
    assert(h.contains("&lt;i&gt;"))   // brand
    assert(h.contains("&lt;u&gt;"))   // foot
}

// --- Topbar (title + hamburger + slots + user chip) ---

@test fn topbar_renders_title_hamburger_slots_and_chip() {
    let actions = html("<a href=\"/lang/en\">ES</a>")
    let trail = html("<a href=\"/logout\">out</a>")
    let h = topbar_render("Panel", "Menú", "Ada Lovelace", "A", actions, trail).raw
    assert(h.contains("class=\"topbar\""))
    assert(h.contains("onclick=\"flvToggleNav()\""))   // hamburger toggles the drawer
    assert(h.contains("aria-label=\"Menú\""))
    assert(h.contains("Panel"))
    assert(h.contains("user-chip"))
    assert(h.contains("user-avatar\">A<"))             // avatar initials
    assert(h.contains("Ada Lovelace"))                 // name
    assert(h.contains("/lang/en"))                     // actions slot (before chip)
    assert(h.contains("/logout"))                      // trail slot (after chip)
}

@test fn topbar_escapes_title_and_user_name() {
    let h = topbar_render("<b>T</b>", "M", "<i>U</i>", "U", html(""), html("")).raw
    assert(h.contains("&lt;b&gt;"))
    assert(h.contains("&lt;i&gt;"))
}

@test fn initials_of_takes_first_letter_upper() {
    assert_eq(initials_of("ada lovelace"), "A")
    assert_eq(initials_of("  bob"), "B")
}

@test fn initials_of_blank_is_a_question_mark() {
    assert_eq(initials_of(""), "?")
    assert_eq(initials_of("   "), "?")
}

// --- AppShell (document layout + baked chrome CSS + behavior script) ---

@test fn app_shell_assembles_document_with_pieces_and_chrome() {
    let h = app_shell(
        "Panel · Fitz Admin",
        "es",
        html("<meta name=\"head-marker\" />"),           // head_extra
        html("<aside class=\"sidebar\">SB</aside>"),     // sidebar
        html("<header class=\"topbar\">TB</header>"),    // topbar
        html("<div class=\"crumb-bar\">CB</div>"),       // crumbs
        html("<h2>Body</h2>"),                           // body
        html("<script>/*extra*/</script>"),             // body_extra
    ).raw
    assert(h.contains("<!doctype html>"))
    assert(h.contains("<html lang=\"es\" data-theme=\"auto\">"))
    assert(h.contains("<title>Panel · Fitz Admin</title>"))
    assert(h.contains("head-marker"))                    // head_extra baked in
    assert(h.contains("class=\"admin\""))
    assert(h.contains("<aside class=\"sidebar\">SB</aside>"))
    assert(h.contains("<header class=\"topbar\">TB</header>"))
    assert(h.contains("crumb-bar"))
    assert(h.contains("<main class=\"content\">"))
    assert(h.contains("<h2>Body</h2>"))
    assert(h.contains("drawer-overlay"))
    assert(h.contains("window.flvToggleNav"))            // baked behavior script
    assert(h.contains("/*extra*/"))                      // body_extra baked in
    // the chrome stylesheet is baked (tokens + selectors)
    assert(h.contains("--sidebar-bg"))
    assert(h.contains("max-width: 1200px"))              // .content chrome rule
}

@test fn ui_shell_css_has_chrome_selectors_not_screen_css() {
    let css = ui_shell_css()
    // brace-free markers unique to each chrome selector
    assert(css.contains("min-height: 100vh"))            // .admin
    assert(css.contains("width: 240px"))                 // .sidebar
    assert(css.contains("height: 56px"))                 // .topbar
    assert(css.contains("max-width: 1200px"))            // .content
    assert(css.contains("drawer-overlay"))
    assert(css.contains("--sidebar-bg"))
    assert(css.contains("--flv-color-primary"))          // companion UI tokens
    assert(css.contains("max-width: 768px"))             // drawer media query
    assert(css.contains("nav-collapsed"))                // desktop collapse
    // screen-specific CSS belongs to the host, not the chrome sheet
    assert(not css.contains(".stat-card"))
    assert(not css.contains(".login-card"))
}

@test fn shell_behavior_script_defines_nav_toggles() {
    let s = shell_behavior_script().raw
    assert(s.contains("<script>"))
    assert(s.contains("window.flvToggleNav"))
    assert(s.contains("window.flvCloseDrawer"))
    assert(s.contains("nav-open"))
    assert(s.contains("nav-collapsed"))
}

// === Dashboard family (Session D) — StatCard / BarChart / ProgressBar ===
// Presentational .fitzv primitives with scoped styles, plus chart_helpers
// (`Bar` / `pct_of` / `bar_scale`) for the cross-item bar scaling.

// --- StatCard ---

@test fn stat_card_renders_label_value_hint_and_accent() {
    let h = stat_card_render(stat_card { label: "Empleados", value: 42, hint: "Total", accent: "blue" }).raw
    assert(h.contains("flv-statcard"))
    assert(h.contains("data-accent=\"blue\""))
    assert(h.contains("Empleados"))
    assert(h.contains(">42<"))          // the value node
    assert(h.contains("Total"))
}

@test fn stat_card_escapes_label_and_hint() {
    let h = stat_card_render(stat_card { label: "<b>L</b>", hint: "<i>H</i>", value: 1 }).raw
    assert(h.contains("&lt;b&gt;"))
    assert(h.contains("&lt;i&gt;"))
}

// --- chart_helpers (pct_of / bar_scale) ---

@test fn pct_of_guards_zero_max_and_clamps() {
    assert_eq(pct_of(5, 0), 0)          // no division by zero
    assert_eq(pct_of(5, -3), 0)
    assert_eq(pct_of(3, 10), 30)
    assert_eq(pct_of(10, 10), 100)
    assert_eq(pct_of(15, 10), 100)      // clamped to 100
}

@test fn bar_scale_sizes_bars_to_the_busiest() {
    let bars: List<Bar> = [
        Bar { label: "A", value: 2 },
        Bar { label: "B", value: 8 },
        Bar { label: "C", value: 0 },
    ]
    let scaled = bar_scale(bars)
    assert_eq(scaled[0].pct, 25)        // 2 of 8
    assert_eq(scaled[1].pct, 100)       // the busiest
    assert_eq(scaled[2].pct, 0)
    // copy-out: the input list is left untouched
    assert_eq(bars[0].pct, 0)
}

// --- BarChart ---

@test fn bar_chart_renders_scaled_rows() {
    let bars: List<Bar> = bar_scale([Bar { label: "Sales", value: 4 }, Bar { label: "Eng", value: 8 }])
    let h = bar_chart_render(bar_chart { bars: bars }).raw
    assert(h.contains("flv-chart-row"))
    assert(h.contains("Sales"))
    assert(h.contains("Eng"))
    assert(h.contains("width: 50%"))    // 4 of 8
    assert(h.contains("width: 100%"))   // the busiest bar
}

@test fn bar_chart_empty_renders_no_bars() {
    let bars: List<Bar> = []
    let h = bar_chart_render(bar_chart { bars: bars }).raw
    // the container renders; with no data there are no bars (key on the inline
    // width, since the scoped <style> always names the row/label classes)
    assert(h.contains("flv-chart"))
    assert(not h.contains("style=\"width:"))
}

// --- ProgressBar ---

@test fn progress_bar_renders_label_ratio_and_fill() {
    let h = progress_bar_render(progress_bar { label: "Active", value: 3, max: 10, pct: 30, accent: "green" }).raw
    assert(h.contains("Active"))
    assert(h.contains("3/10 · 30%"))
    assert(h.contains("data-accent=\"green\""))
    assert(h.contains("width: 30%"))
}

@test fn progress_bar_escapes_label() {
    let h = progress_bar_render(progress_bar { label: "<b>x</b>", value: 1, max: 2, pct: 50 }).raw
    assert(h.contains("&lt;b&gt;"))
}

// === DataGrid family (Session E) — DataGrid / SortableHeader / GridToolbar /
// GridFilters (presentational, controlled) + grid_helpers (Pill / sort_arrow).

// --- sort_arrow (helper) ---

@test fn sort_arrow_marks_active_column_by_direction() {
    assert_eq(sort_arrow("nombre", "nombre", "asc"), " ▲")
    assert_eq(sort_arrow("nombre", "nombre", "desc"), " ▼")
    assert_eq(sort_arrow("email", "nombre", "asc"), "")   // inactive column
}

// --- SortableHeader ---

@test fn sortable_header_renders_th_with_sort_event_and_col_payload() {
    let h = sortable_header_render(sortable_header { label: "Nombre", col: "nombre", active_col: "id", dir: "asc" }).raw
    assert(h.contains("data-flv-click=\"sort\""))
    assert(h.contains("data-flv-value-col=\"nombre\""))
    assert(h.contains("flv-th-sort"))
    assert(h.contains("Nombre"))
    // inactive column: no arrow
    assert(not h.contains("▲"))
    assert(not h.contains("▼"))
}

@test fn sortable_header_active_column_shows_arrow_and_merges_class() {
    let asc = sortable_header_render(sortable_header { label: "ID", col: "id", cls: "col-id", active_col: "id", dir: "asc" }).raw
    assert(asc.contains("ID ▲"))
    assert(asc.contains("col-id"))
    let desc = sortable_header_render(sortable_header { label: "ID", col: "id", active_col: "id", dir: "desc" }).raw
    assert(desc.contains("ID ▼"))
}

@test fn sortable_header_custom_sort_event() {
    let h = sortable_header_render(sortable_header { label: "X", col: "x", sort_event: "reorder" }).raw
    assert(h.contains("data-flv-click=\"reorder\""))
}

// --- GridToolbar ---

@test fn grid_toolbar_search_form_submits_and_escapes_value() {
    let h = grid_toolbar_render(grid_toolbar { q: "a\"b", placeholder: "Buscar", search_label: "Buscar" }).raw
    assert(h.contains("data-flv-submit=\"search\""))
    assert(h.contains("name=\"q\""))
    assert(h.contains("value=\"a&quot;b\""))     // escaped
    assert(h.contains("placeholder=\"Buscar\""))
    assert(h.contains(">Buscar</button>"))         // search button label
}

@test fn grid_toolbar_clear_button_only_when_labeled() {
    let with_clear = grid_toolbar_render(grid_toolbar { clear_label: "Limpiar", search_event: "search" }).raw
    // the clear button re-fires the search event with an empty q payload
    assert(with_clear.contains("data-flv-value-q=\"\""))
    assert(with_clear.contains(">Limpiar</button>"))
    let without = grid_toolbar_render(grid_toolbar { }).raw
    assert(not without.contains("data-flv-value-q"))
}

@test fn grid_toolbar_renders_raw_actions_slot() {
    let h = grid_toolbar_render(grid_toolbar { actions: "<button class=\"btn-primary\">+ New</button>" }).raw
    assert(h.contains("flv-grid-actions"))
    assert(h.contains("<button class=\"btn-primary\">+ New</button>"))  // RAW
}

@test fn grid_toolbar_custom_search_event() {
    let h = grid_toolbar_render(grid_toolbar { search_event: "buscar_dep" }).raw
    assert(h.contains("data-flv-submit=\"buscar_dep\""))
}

// --- GridFilters ---

@test fn grid_filters_renders_pills_with_events_and_active() {
    let pills: List<Pill> = [
        Pill { label: "Todos", event: "estado_all", active: true },
        Pill { label: "Activos", event: "estado_active" },
    ]
    let h = grid_filters_render(grid_filters { pills: pills, filter_label: "Estado" }).raw
    assert(h.contains(">Estado</span>"))              // filter label
    assert(h.contains("data-flv-click=\"estado_all\""))
    assert(h.contains("data-flv-click=\"estado_active\""))
    assert(h.contains("flv-pill-active"))             // the active pill
    assert(h.contains(">Todos</button>"))
}

@test fn grid_filters_value_payload_shape() {
    // one shared event + a value the host loop reads as payload["value"]
    let pills: List<Pill> = [
        Pill { label: "Todos", event: "filter_depto", value: "0", active: true },
        Pill { label: "Ing", event: "filter_depto", value: "7" },
    ]
    let h = grid_filters_render(grid_filters { pills: pills }).raw
    assert(h.contains("data-flv-value-value=\"0\""))
    assert(h.contains("data-flv-value-value=\"7\""))
}

@test fn grid_filters_escapes_labels_and_hides_label_when_empty() {
    let pills: List<Pill> = [Pill { label: "<b>x</b>", event: "e" }]
    let h = grid_filters_render(grid_filters { pills: pills }).raw
    assert(h.contains("&lt;b&gt;"))
    // no filter_label → no label span
    assert(not h.contains("flv-filter-label flv-filter-label-"))
}

// --- DataGrid ---

@test fn data_grid_renders_head_body_and_footer_info() {
    let h = data_grid_render(data_grid {
        head: "<tr><th>ID</th></tr>",
        body: "<tr data-flv-key=\"r-1\"><td data-label=\"ID\">1</td></tr>",
        info: "Página 1 de 3",
        foot: "<div class=\"pager\"></div>",
        cols: 1
    }).raw
    assert(h.contains("flv-grid-card"))
    assert(h.contains("<table class=\"flv-grid"))
    assert(h.contains("<tr><th>ID</th></tr>"))               // head RAW
    assert(h.contains("data-label=\"ID\""))                  // body RAW
    assert(h.contains("flv-grid-foot"))
    assert(h.contains("Página 1 de 3"))
    assert(h.contains("<div class=\"pager\"></div>"))        // foot RAW
}

@test fn data_grid_empty_body_renders_centered_empty_row() {
    let h = data_grid_render(data_grid { head: "<tr><th>ID</th></tr>", body: "", empty: "Sin datos", cols: 4 }).raw
    assert(h.contains("flv-grid-empty"))
    assert(h.contains("colspan=\"4\""))
    assert(h.contains("Sin datos"))
}

@test fn data_grid_no_info_omits_footer() {
    let h = data_grid_render(data_grid { head: "<tr></tr>", body: "<tr><td>x</td></tr>" }).raw
    // the scoped <style> always names .flv-grid-foot; key on the wrapper element
    assert(not h.contains("flv-grid-foot flv-grid-foot-"))
}

// === Forms family (Session F) — Textarea / Select / Checkbox / CheckboxGroup /
// RadioGroup / Rating / DatePicker (presentational form inputs) +
// form_input_helpers (FieldOption / rating_stars).

// --- rating_stars (helper) ---

@test fn rating_stars_emits_reversed_radios_with_selected_checked() {
    let h = rating_stars("nivel", 3, 5)
    // radios emitted max→1 (row-reverse CSS); star 3 pre-checked. This is a
    // classic string helper, so the bool attr is bare `checked` (the .fitzv
    // emitter would normalize it to `checked=""`).
    assert(h.contains("value=\"5\""))
    assert(h.contains("value=\"1\""))
    assert(h.contains("value=\"3\" checked"))
    assert(not h.contains("value=\"5\" checked"))
    // first radio emitted is the top star (id nivel-5)
    assert(h.contains("id=\"nivel-5\""))
    assert(h.contains("id=\"nivel-1\""))
}

// --- Textarea ---

@test fn textarea_renders_name_rows_value_and_hint() {
    let h = textarea_render(textarea { name: "notas", label: "Notas", value: "hola", rows: 4, hint: "opcional" }).raw
    assert(h.contains("name=\"notas\""))
    assert(h.contains("rows=\"4\""))
    assert(h.contains(">hola</textarea>"))
    assert(h.contains(">Notas</span>"))
    assert(h.contains("opcional"))
}

@test fn textarea_error_hides_hint_and_escapes_value() {
    let h = textarea_render(textarea { name: "x", value: "<b>y</b>", error: "requerido", hint: "pista" }).raw
    assert(h.contains("flv-field-error"))
    assert(h.contains("requerido"))
    assert(not h.contains("pista"))
    assert(h.contains("&lt;b&gt;"))
}

@test fn textarea_disabled_renders_disabled() {
    let h = textarea_render(textarea { name: "x", disabled: true }).raw
    assert(h.contains("disabled"))
}

// --- Select ---

@test fn select_renders_options_with_selected_and_change() {
    let opts: List<FieldOption> = [
        FieldOption { label: "All", value: "0", on: true },
        FieldOption { label: "Eng", value: "1" },
    ]
    let h = select_render(select { name: "dept", label: "Dept", options: opts, on_change: "cascade" }).raw
    assert(h.contains("name=\"dept\""))
    assert(h.contains("data-flv-change=\"cascade\""))
    // the .fitzv emitter normalizes the bare `selected` bool attr to selected=""
    assert(h.contains("<option value=\"0\" selected=\"\">All</option>"))
    assert(h.contains("<option value=\"1\">Eng</option>"))
}

@test fn select_without_change_omits_change_attr() {
    let opts: List<FieldOption> = [FieldOption { label: "A", value: "1" }]
    let h = select_render(select { name: "x", options: opts }).raw
    assert(not h.contains("data-flv-change"))
}

@test fn select_escapes_option_labels() {
    let opts: List<FieldOption> = [FieldOption { label: "<b>x</b>", value: "1" }]
    let h = select_render(select { name: "x", options: opts }).raw
    assert(h.contains("&lt;b&gt;"))
}

// --- Checkbox ---

@test fn checkbox_renders_checked_state_and_label() {
    let on = checkbox_render(checkbox { name: "ok", label: "Acepto", value: "yes", on: true }).raw
    assert(on.contains("name=\"ok\""))
    assert(on.contains("value=\"yes\""))
    assert(on.contains("checked"))
    assert(on.contains(">Acepto</span>"))
    let off = checkbox_render(checkbox { name: "ok", label: "Acepto", on: false }).raw
    assert(not off.contains("checked"))
}

// --- CheckboxGroup ---

@test fn checkbox_group_shares_name_and_marks_checked() {
    let opts: List<FieldOption> = [
        FieldOption { label: "Rust", value: "1", on: true },
        FieldOption { label: "Fitz", value: "2" },
    ]
    let h = checkbox_group_render(checkbox_group { name: "skills", label: "Skills", options: opts }).raw
    // both boxes share the name
    assert(h.contains("name=\"skills\" value=\"1\" checked"))
    assert(h.contains("name=\"skills\" value=\"2\" />"))
    assert(h.contains(">Skills</span>"))
}

@test fn checkbox_group_chips_variant_uses_has_checked_css() {
    let opts: List<FieldOption> = [FieldOption { label: "A", value: "1" }]
    let h = checkbox_group_render(checkbox_group { name: "x", options: opts, chips: true }).raw
    assert(h.contains("flv-check-chips"))
    // the chip fill is pure CSS: :has(input:checked)
    assert(h.contains(":has(input:checked)"))
}

// --- RadioGroup ---

@test fn radio_group_renders_exclusive_radios() {
    let opts: List<FieldOption> = [
        FieldOption { label: "Activo", value: "true", on: true },
        FieldOption { label: "Inactivo", value: "false" },
    ]
    let h = radio_group_render(radio_group { name: "activo", label: "Estado", options: opts }).raw
    assert(h.contains("type=\"radio\" name=\"activo\" value=\"true\" checked"))
    assert(h.contains("type=\"radio\" name=\"activo\" value=\"false\" />"))
    assert(h.contains(">Estado</span>"))
}

// --- Rating ---

@test fn rating_renders_stars_with_value_checked() {
    let h = rating_render(rating { name: "nivel", value: 3, max: 5 }).raw
    assert(h.contains("flv-rating"))
    assert(h.contains("★"))
    assert(h.contains("value=\"3\" checked"))
    // pure-CSS star fill
    assert(h.contains("input:checked ~ label"))
}

@test fn rating_zero_has_no_checked_star() {
    let h = rating_render(rating { name: "nivel", value: 0, max: 5 }).raw
    // no radio carries the checked attr (the scoped CSS still names `:checked`,
    // so key on the radio's ` checked />` shape, not the bare word "checked")
    assert(not h.contains(" checked />"))
}

// --- DatePicker ---

@test fn date_picker_renders_native_date_input() {
    let h = date_picker_render(date_picker { name: "fecha", label: "Fecha", value: "2026-07-30" }).raw
    assert(h.contains("type=\"date\""))
    assert(h.contains("name=\"fecha\""))
    assert(h.contains("value=\"2026-07-30\""))
    assert(h.contains(">Fecha</span>"))
}

@test fn date_picker_error_switches_style() {
    let h = date_picker_render(date_picker { name: "x", error: "fecha inválida", hint: "pista" }).raw
    assert(h.contains("flv-field-error"))
    assert(h.contains("fecha inválida"))
    assert(not h.contains("pista"))
}

// === Forms-composite family (Session G) — FormLayout / FormRow / GroupSelect /
// MultiSelect / Tabs / Stepper / TreeView + form_layout_helpers.

// --- tree_arrow (helper) ---

@test fn tree_arrow_reflects_expanded() {
    assert_eq(tree_arrow(true), "▾")
    assert_eq(tree_arrow(false), "▸")
}

// --- FormLayout ---

@test fn form_layout_wraps_body_in_form_with_submit() {
    let h = form_layout_render(form_layout { submit_event: "save_user", body: "<p>x</p>" }).raw
    assert(h.contains("data-flv-submit=\"save_user\""))
    assert(h.contains("<p>x</p>"))                 // body is RAW
    assert(h.contains("flv-form-card"))            // card by default
}

@test fn form_layout_no_card_omits_wrapper() {
    let h = form_layout_render(form_layout { body: "<p>x</p>", card: false }).raw
    assert(not h.contains("flv-form-card flv-form-card-"))
}

// --- FormRow ---

@test fn form_row_labeled_renders_label_and_field() {
    let h = form_row_render(form_row { label: "Desempeño", field: "<div>★</div>" }).raw
    assert(h.contains("flv-form-row"))
    assert(h.contains(">Desempeño</label>"))
    assert(h.contains("<div>★</div>"))             // field is RAW
}

@test fn form_row_grid_mode_sets_cols() {
    let h = form_row_render(form_row { field: "<span>a</span>", cols: 2 }).raw
    assert(h.contains("flv-form-grid"))
    assert(h.contains("data-cols=\"2\""))
}

// --- GroupSelect ---

@test fn group_select_renders_optgroups_and_head() {
    let groups: List<OptionGroup> = [
        OptionGroup { label: "Eng", options: [FieldOption { label: "Ada", value: "1", on: true }] },
    ]
    let h = group_select_render(group_select { name: "boss", label: "Reporta", groups: groups, head_label: "— none —", head_on: false }).raw
    assert(h.contains("<optgroup label=\"Eng\">"))
    assert(h.contains("<option value=\"1\" selected=\"\">Ada</option>"))
    assert(h.contains("<option value=\"0\">— none —</option>"))  // head, not selected
    assert(h.contains("name=\"boss\""))
}

// --- MultiSelect ---

@test fn multi_select_renders_fieldset_per_group_sharing_name() {
    let groups: List<OptionGroup> = [
        OptionGroup { label: "Empleados", options: [FieldOption { label: "Ver", value: "1", on: true }, FieldOption { label: "Editar", value: "2" }] },
    ]
    let h = multi_select_render(multi_select { name: "permisos", label: "Permisos", groups: groups }).raw
    assert(h.contains("<fieldset"))
    assert(h.contains(">Empleados</legend>"))
    assert(h.contains("name=\"permisos\" value=\"1\" checked"))
    assert(h.contains("name=\"permisos\" value=\"2\" />"))
}

// --- Tabs ---

@test fn tabs_marks_active_and_carries_form_serialization() {
    let items: List<Tab> = [
        Tab { label: "Datos", value: "datos", active: true },
        Tab { label: "Org", value: "org" },
    ]
    let h = tabs_render(tabs { items: items }).raw
    assert(h.contains("flv-tab-on"))
    assert(h.contains("data-flv-form"))
    assert(h.contains("data-flv-click=\"form_tab\" data-flv-value-tab=\"datos\""))
    assert(h.contains("data-flv-value-tab=\"org\""))
}

@test fn tabs_custom_event() {
    let items: List<Tab> = [Tab { label: "A", value: "a", active: true }]
    let h = tabs_render(tabs { items: items, tab_event: "switch" }).raw
    assert(h.contains("data-flv-click=\"switch\""))
}

// --- Stepper ---

@test fn stepper_marks_step_states() {
    let steps: List<Step> = [
        Step { label: "Datos", state: "done" },
        Step { label: "Org", state: "active" },
        Step { label: "Accesos", state: "pending" },
    ]
    let h = stepper_render(stepper { steps: steps }).raw
    assert(h.contains("data-state=\"done\""))
    assert(h.contains("data-state=\"active\""))
    assert(h.contains("data-state=\"pending\""))
    assert(h.contains(">Datos</span>"))
    // numbers come from a CSS counter (no per-step number in markup)
    assert(h.contains("counter(flvstep)"))
}

// --- TreeView ---

@test fn tree_view_renders_flattened_nodes_with_indent_and_arrows() {
    let nodes: List<TreeNode> = [
        TreeNode { label: "Argentina", depth: 0, expanded: true, event: "toggle_pais", value: "1", icon: "🌎" },
        TreeNode { label: "El Chaltén", depth: 2, leaf: true, icon: "📍" },
        TreeNode { label: "Chile", depth: 0, expanded: false, event: "toggle_pais", value: "2" },
    ]
    let h = tree_view_render(tree_view { nodes: nodes }).raw
    // branch node: arrow + toggle event + indent
    assert(h.contains("data-flv-click=\"toggle_pais\" data-flv-value-value=\"1\""))
    assert(h.contains("▾"))                         // Argentina expanded
    assert(h.contains("▸"))                         // Chile collapsed
    assert(h.contains("style=\"padding-left: 0rem\""))
    // leaf: plain row, deeper indent, no toggle button
    assert(h.contains("flv-tree-leaf"))
    assert(h.contains("style=\"padding-left: 2rem\""))
    assert(h.contains("El Chaltén"))
}

// === Feedback family (Session H) — Chip / CountBadge / Tooltip / Divider /
// ExpansionPanel (presentational, SSR).

@test fn chip_renders_label_and_variant() {
    let h = chip_render(chip { label: "Rust", variant: "success" }).raw
    assert(h.contains("flv-chip"))
    assert(h.contains("data-variant=\"success\""))
    assert(h.contains(">Rust</span>"))
}

@test fn chip_escapes_label_and_defaults_to_primary() {
    let h = chip_render(chip { label: "<b>x</b>" }).raw
    assert(h.contains("data-variant=\"primary\""))
    assert(h.contains("&lt;b&gt;"))
}

@test fn count_badge_shows_count() {
    let h = count_badge_render(count_badge { count: 7, variant: "danger" }).raw
    assert(h.contains("flv-count-badge"))
    assert(h.contains("data-variant=\"danger\""))
    assert(h.contains(">7</span>"))
}

@test fn count_badge_caps_at_max() {
    let over = count_badge_render(count_badge { count: 128, max: 99 }).raw
    assert(over.contains(">99+</span>"))
    let under = count_badge_render(count_badge { count: 42, max: 99 }).raw
    assert(under.contains(">42</span>"))
    assert(not under.contains("+"))
}

@test fn tooltip_wraps_content_and_carries_escaped_tip() {
    let h = tooltip_render(tooltip { content: "<span>?</span>", tip: "Ayuda \"x\"" }).raw
    assert(h.contains("flv-tooltip"))
    assert(h.contains("<span>?</span>"))              // content is RAW
    assert(h.contains("data-tip=\"Ayuda &quot;x&quot;\""))  // tip escaped
}

@test fn divider_plain_is_an_hr() {
    let h = divider_render(divider { }).raw
    assert(h.contains("<hr class=\"flv-divider"))
    assert(not h.contains("flv-divider-labeled flv-divider-labeled-"))
}

@test fn divider_labeled_renders_caption() {
    let h = divider_render(divider { label: "o" }).raw
    assert(h.contains("flv-divider-labeled"))
    assert(h.contains(">o</span>"))
}

@test fn expansion_panel_open_renders_details_with_body() {
    let h = expansion_panel_render(expansion_panel { summary: "Detalles", body: "<p>rico</p>", open: true }).raw
    assert(h.contains("<details class=\"flv-exp"))
    assert(h.contains("open"))
    assert(h.contains(">Detalles</summary>"))
    assert(h.contains("<p>rico</p>"))                 // body is RAW
}

@test fn expansion_panel_closed_omits_open_attr() {
    let h = expansion_panel_render(expansion_panel { summary: "x", body: "y" }).raw
    assert(h.contains("<details class=\"flv-exp"))
    assert(not h.contains("open>"))
    assert(not h.contains("open=\"\""))
}
