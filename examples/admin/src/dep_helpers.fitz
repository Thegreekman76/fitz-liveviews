// Pure helper for DepartamentoRow.fitzv — wraps the one thing the view DSL
// can't express inline: the código Chip (a composed library component, injected
// raw in a <td>). The i18n tooltip + form placeholders used to live here too,
// but since fitz core v0.37.17 (nested double quotes in attribute values) they
// inline directly in the .fitzv as `data-tooltip="{t(locale, "…")}"` /
// `placeholder="{flv(t(locale, "…"))}"`. Same split as row_helpers.fitz.
from fitz_liveviews import Html
from fitz_liveviews.ui.Chip import chip, chip_render

// --- DepartamentoRow ---
fn dep_codigo_chip(codigo: Str) -> Html => chip_render(chip { label: codigo })
