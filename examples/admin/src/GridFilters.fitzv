// GridFilters.fitzv — the departamento filter bar + the "Agrupar por" bar, as
// a presentational (controlled) LiveComponent.
//
// Fifth slice of the Admin ABM LiveComponents refactor. Like GridToolbar and
// Pager, this is a CONTROLLED / presentational component: the department list
// `deptos`, the active `depto` filter and the active `group_by` dimension are
// the grid's query state, owned by the parent's `@ws` loop. The parent renders
// it fresh every frame with
// `grid_filters_render(grid_filters { deptos, depto, group_by, locale }).raw`.
//
// It declares NO event handlers, so every pill event (`filter_depto`,
// `group_none` / `group_depto` / `group_estado`) falls through to the parent's
// loop (same fall-through contract Pager/GridToolbar use).
//
// This is the first extracted component whose state holds an imported
// `List<Nominal>` (`List<Departamento>`) and whose template loops it with
// `{#for d in deptos}` — the SSR `{#for}` lowers to `.map`, which List has.
// The active-pill state is `{#if}` / `{#else}` (the DSL has no `match`).
//
// CSS stays GLOBAL (shell.fitz): `.grid-filters` / `.grid-deptos` /
// `.grid-group` / `.filter-label` / `.pill` are shared, so no `<style scoped>`.

from models import Departamento
from i18n import t
from fitz_liveviews import flv

component grid_filters {
  state {
    deptos: List<Departamento> = []
    depto: Int = 0
    group_by: Str = ""
    locale: Str = "es"
  }

  <template>
    <div class="grid-filters grid-deptos">
      <span class="filter-label">{flv(t(locale, "grid.f.depto"))}</span>
      {#if depto == 0}
        <button class="pill pill-active" data-flv-click="filter_depto" data-flv-value-depto="0">{flv(t(locale, "grid.f.all"))}</button>
      {#else}
        <button class="pill" data-flv-click="filter_depto" data-flv-value-depto="0">{flv(t(locale, "grid.f.all"))}</button>
      {/if}
      {#for d in deptos}
        {#if d.id == depto}
          <button class="pill pill-active" data-flv-click="filter_depto" data-flv-value-depto="{d.id}">{flv(d.nombre)}</button>
        {#else}
          <button class="pill" data-flv-click="filter_depto" data-flv-value-depto="{d.id}">{flv(d.nombre)}</button>
        {/if}
      {/for}
    </div>
    <div class="grid-filters grid-group">
      <span class="filter-label">{flv(t(locale, "grid.group.by"))}</span>
      {#if group_by == ""}
        <button class="pill pill-active" data-flv-click="group_none">{flv(t(locale, "grid.group.none"))}</button>
      {#else}
        <button class="pill" data-flv-click="group_none">{flv(t(locale, "grid.group.none"))}</button>
      {/if}
      {#if group_by == "depto"}
        <button class="pill pill-active" data-flv-click="group_depto">{flv(t(locale, "grid.group.depto"))}</button>
      {#else}
        <button class="pill" data-flv-click="group_depto">{flv(t(locale, "grid.group.depto"))}</button>
      {/if}
      {#if group_by == "estado"}
        <button class="pill pill-active" data-flv-click="group_estado">{flv(t(locale, "grid.group.estado"))}</button>
      {#else}
        <button class="pill" data-flv-click="group_estado">{flv(t(locale, "grid.group.estado"))}</button>
      {/if}
    </div>
  </template>
}
