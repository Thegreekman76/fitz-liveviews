// dashboard.fitz — the protected screens of Slice 1.
//
// Each page reads the session cookie with `@header(name="cookie")`, resolves
// the admin via `user_from_cookie(...)`, and on failure returns a 303
// redirect to /login (browser-correct auth — no JSON 401). The dashboard
// itself pulls REAL counts from Postgres via the ORM. Empleados and
// Departamentos are placeholder screens for now — they prove the shell +
// nav + theme + session work across routes; their grids land in Slice 2.

from config import db_url
from models import User, Departamento, Empleado
from session import user_from_cookie
from shell import page_layout, redirect_to
from i18n import t, locale_from_cookie
from fitz_liveviews import Html, html, flv, html_response
// Dashboard-family components (Session D) — presentational, rendered inline.
from fitz_liveviews.ui.StatCard import stat_card, stat_card_render
from fitz_liveviews.ui.BarChart import bar_chart, bar_chart_render
from fitz_liveviews.ui.ProgressBar import progress_bar, progress_bar_render
from fitz_liveviews.ui.chart_helpers import Bar, bar_scale, pct_of

// --- Dashboard body (real DB counts) -------------------------------------

async fn render_dashboard(locale: Str) -> Result<Html> {
    let conn = db.connect(db_url()).await?
    // `count` is a QueryBuilder terminal in the interpreter — so we count
    // via `.where(...).count(conn)`. `id > 0` matches every row (bigserial
    // starts at 1), so it's an all-rows count in SQL.
    let total_emp = Empleado.where(fn(e) => e.id > 0).count(conn).await?
    let activos = Empleado.where(fn(e) => e.activo == true).count(conn).await?
    let inactivos = total_emp - activos
    let n_deptos = Departamento.where(fn(d) => d.id > 0).count(conn).await?

    let c1 = stat_card_render(stat_card { label: t(locale, "dash.stat.empleados"), value: total_emp, hint: t(locale, "dash.stat.empleados.hint"), accent: "blue" }).raw
    let c2 = stat_card_render(stat_card { label: t(locale, "dash.stat.activos"), value: activos, hint: t(locale, "dash.stat.activos.hint"), accent: "green" }).raw
    let c3 = stat_card_render(stat_card { label: t(locale, "dash.stat.inactivos"), value: inactivos, hint: t(locale, "dash.stat.inactivos.hint"), accent: "amber" }).raw
    let c4 = stat_card_render(stat_card { label: t(locale, "dash.stat.deptos"), value: n_deptos, hint: t(locale, "dash.stat.deptos.hint"), accent: "violet" }).raw

    // Chart data: every department + every employee, counted in Fitz. Build a
    // `List<Bar>` (label + count) and let `bar_scale` size each bar to the
    // busiest department.
    let deptos = Departamento.where(fn(d) => d.id > 0).order_by(fn(d) => d.nombre).all(conn).await?
    let all_emp = Empleado.where(fn(e) => e.id > 0).all(conn).await?
    let bars: List<Bar> = deptos.map(fn(d) => Bar { label: d.nombre, value: all_emp.filter(fn(e) => e.departamento_id == d.id).len() })
    let chart = bar_chart_render(bar_chart { bars: bar_scale(bars) }).raw

    // ProgressBars — headline ratios.
    let pb_act = progress_bar_render(progress_bar { label: t(locale, "dash.stat.activos"), value: activos, max: total_emp, pct: pct_of(activos, total_emp), accent: "green" }).raw
    let pb_ina = progress_bar_render(progress_bar { label: t(locale, "dash.stat.inactivos"), value: inactivos, max: total_emp, pct: pct_of(inactivos, total_emp), accent: "amber" }).raw

    let d_title = t(locale, "dash.title")
    let d_sub = t(locale, "dash.subtitle")
    let d_live = t(locale, "dash.live")
    let d_occ = t(locale, "dash.occupancy")
    let d_bydep = t(locale, "dash.by_depto")
    return Ok(html("""<div class="page-head">
      <h2>{flv(d_title)} <span class="live-dot"><span class="spinner"></span> {flv(d_live)}</span></h2>
      <p>{flv(d_sub)}</p>
    </div>
    <div class="stat-grid">
      {c1}{c2}{c3}{c4}
    </div>
    <div class="panel">
      <h3>{flv(d_occ)}</h3>
      <div class="pbars">{pb_act}{pb_ina}</div>
      <hr class="divider" />
      <details class="exp-panel" open>
        <summary>{flv(d_bydep)}</summary>
        {chart}
      </details>
    </div>"""))
}

// --- Routes ---------------------------------------------------------------

@header(name="cookie")
@get("/")
async fn dashboard_page(cookie: Str?) -> Response {
    let user: User = match user_from_cookie(cookie).await {
        Ok(u) => u,
        Err(_) => return redirect_to("/login"),
    }
    let loc = locale_from_cookie(cookie)
    let body: Html = match render_dashboard(loc).await {
        Ok(h) => h,
        Err(e) => html("""<div class="panel"><h3>{flv(t(loc, "dash.db_error"))}</h3><p>{flv(e)}</p></div>"""),
    }
    return html_response(page_layout(t(loc, "nav.dashboard"), "dashboard", user.name, body, loc))
}

// NOTE: `/empleados` moved to empleados.fitz in Slice 2 — it's now the live
// DataGrid. `/departamentos` moved to departamentos.fitz — the live ABM.
