// main.fitz — orchestrator for the Admin ABM showcase (Slice 1).
//
// Wires the feature modules into one server:
//   - auth.fitz       → GET/POST /login, GET /logout (session cookie).
//   - dashboard.fitz  → GET / , /empleados, /departamentos (protected).
//
// `import <module>` is enough for the runtime/codegen to plug each module's
// HTTP handlers into the router (W16 cross-module). The server binds on
// 0.0.0.0 so it works both under `fitz run` and inside Docker.
//
// The database schema + demo seed live in `db/init.sql` (run by Postgres on
// first boot, or with `psql -f db/init.sql` locally). The app never touches
// the schema at boot and only connects during requests — see db/init.sql
// for why. So there's nothing to run here at startup: just serve.
//
// Slice 2 adds the live WebSocket layer: `empleados.fitz` serves the
// Empleados DataGrid over `/empleados` (SSR first paint) + `/live/empleados`
// (WS pagination). The rest stays SSR.

import auth
import dashboard
import empleados
import departamentos

// LiveComponents — the SFC must be imported by THIS entry file (and
// `flv_register` must be in scope) for the compiler's auto-registration
// (Fitz core §9.bb) to see it: the pre-scan walks the entry's DIRECT
// imports only, same one-level rule as the auth/background pre-scans.
// `Html` must also be imported here so the render fn's cross-module
// signature resolves to `-> Html` (not a degraded `Any`) — same
// convention as the course C2/C3 mains (v0.28.4 note).
from fitz_liveviews import flv_register, Html
from fitz_liveviews.ui.ConfirmDialog import confirm_dialog, confirm_dialog_render, confirm_dialog_ask, confirm_dialog_cancel
from fitz_liveviews.ui.Toast import toast, toast_render, toast_show, toast_dismiss
// Presentational primitives adopted by the grid/form (rendered inline with
// `_render(...).raw`). Imported HERE — the @server entry — so the compiler
// auto-registers them (§9.bb one-level pre-scan) and their cross-module render-fn
// signatures resolve to `-> Html` (ui-components.md wiring gotchas).
from fitz_liveviews.ui.Button import button, button_render
from fitz_liveviews.ui.Card import card, card_render
from fitz_liveviews.ui.Input import input, input_render
from fitz_liveviews.ui.Alert import alert, alert_render
// Dashboard-family primitives (Session D) — rendered by dashboard.fitz; imported
// here so the compiler auto-registers them (§9.bb) and their cross-module
// render-fn signatures resolve to `-> Html`.
from fitz_liveviews.ui.StatCard import stat_card, stat_card_render
from fitz_liveviews.ui.BarChart import bar_chart, bar_chart_render
from fitz_liveviews.ui.ProgressBar import progress_bar, progress_bar_render
// DataGrid family (Session E) — the table shell + sortable headers + toolbar +
// filter pills, rendered by empleados.fitz / departamentos.fitz. Imported HERE
// so the compiler auto-registers them and their cross-module render-fn
// signatures resolve to `-> Html`. `Pill` (grid_helpers) is imported so the
// cross-module `List<Pill>` in GridFilters' state resolves.
from fitz_liveviews.ui.DataGrid import data_grid, data_grid_render
from fitz_liveviews.ui.SortableHeader import sortable_header, sortable_header_render
from fitz_liveviews.ui.GridToolbar import grid_toolbar, grid_toolbar_render
from fitz_liveviews.ui.GridFilters import grid_filters, grid_filters_render
from fitz_liveviews.ui.grid_helpers import Pill, sort_arrow

@server(3000, "0.0.0.0")
fn main() => 0

print("[ready] Admin ABM — http://127.0.0.1:3000/")
print("[ready] login demo: admin@fitz.dev / admin1234")
print("[ready] routes: /login  /  /empleados (live)  /departamentos (live)  /logout")
