// EmpleadoForm.fitzv — the create/edit employee form, as a presentational
// (controlled) LiveComponent. Fourth (and last) slice of the Admin ABM refactor.
//
// Like the other extracted pieces this is CONTROLLED / presentational: every
// prop is the form's per-connection state, owned by the parent's `@ws` loop
// (`form_screen` renders it fresh each frame). It declares NO event handlers, so
// `save_empleado` / `form_tab` / `cancel_form` / `cascade_*` all fall through to
// the parent's loop (same fall-through contract as Pager/GridFilters/EmpleadoRow).
//
// Enfoque thin-shell: the template is the stable STRUCTURE (page-head, form, the
// 3 panels, selects, footer). The variable CONTENT — the `<option>` lists,
// permisos/skills, stepper/tabs nav, banner — comes from `form_helpers.fitz`,
// interpolated raw (gotcha #2). The text inputs are inline: `value="{flv(f_x)}"`
// is fine in an attribute (a fn call with no nested string literal, gotcha #8);
// placeholders and panel classes carry an i18n string-key that can't sit in an
// attribute (gotcha #1), so they go through per-key helpers (ph_* / panel_cls_*).
// The estado radios' `checked` uses inline `{#if}` (gotcha #6 forbids a bare
// `{...}` in attribute position).
//
// ALL 3 panels stay in the DOM (only the active one is shown, via CSS) so the
// form serializes every field on save regardless of the active tab.
//
// CSS stays GLOBAL (shell.fitz): `.abm-form` / `.form-row` / `.tab-panel` / … are
// shared, so no `<style scoped>`.

from form_helpers import form_banner, form_header_nav, form_footer_nav, panel_cls_datos, panel_cls_org, panel_cls_accesos, field_nombre, field_email, field_cargo, field_fecha, field_notas, field_estado, field_rating, field_depto, field_skills, field_reporta, field_pais, field_provincia, field_ciudad, field_permisos
from models import Departamento, Pais, Provincia, Ciudad, Permiso, Skill, Empleado
from i18n import t
from fitz_liveviews import flv

component empleado_form {
  state {
    edit_id: Int = 0
    deptos: List<Departamento> = []
    paises: List<Pais> = []
    provincias: List<Provincia> = []
    ciudades: List<Ciudad> = []
    permisos: List<Permiso> = []
    skills: List<Skill> = []
    colegas: List<Empleado> = []
    f_nombre: Str = ""
    f_email: Str = ""
    f_cargo: Str = ""
    f_depto: Int = 0
    f_pais: Int = 0
    f_provincia: Int = 0
    f_ciudad: Int = 0
    f_reporta: Int = 0
    f_fecha: Str = ""
    f_notas: Str = ""
    f_nivel: Int = 0
    f_permisos: Str = ""
    f_skills: Str = ""
    f_activo: Bool = true
    f_tab: Str = "datos"
    error: Str = ""
    locale: Str = "es"
  }

  <template>
    <div id="empleados-live" class="grid-wrap">
      <div class="page-head">
        <h2>{#if edit_id == 0}{flv(t(locale, "form.title.new"))}{#else}{flv(t(locale, "form.title.edit"))}{/if}</h2>
        <p>{flv(t(locale, "form.subtitle"))}</p>
      </div>
      <div class="grid-card form-card">
        {form_banner(error)}
        <form class="abm-form" data-flv-submit="save_empleado">
          <input type="hidden" name="id" value="{edit_id}" />
          {form_header_nav(edit_id, f_tab, locale)}

          <div class="{panel_cls_datos(f_tab)}">
            {field_nombre(f_nombre, locale)}
            {field_email(f_email, locale)}
            <div class="form-grid-2">
              {field_cargo(f_cargo, locale)}
              {field_fecha(f_fecha, locale)}
            </div>
            <div class="form-grid-2">
              {field_estado(f_activo, locale)}
              <div class="form-row">
                <label>{flv(t(locale, "form.desempeno"))}</label>
                {field_rating(f_nivel)}
              </div>
            </div>
            {field_notas(f_notas, locale)}
          </div>

          <div class="{panel_cls_org(f_tab)}">
            <div class="form-grid-2">
              {field_depto(deptos, f_depto, locale)}
              {field_reporta(colegas, deptos, edit_id, f_reporta, locale)}
            </div>
            <div class="form-grid-3">
              {field_pais(paises, f_pais, locale)}
              {field_provincia(provincias, f_provincia, locale)}
              {field_ciudad(ciudades, f_ciudad, locale)}
            </div>
          </div>

          <div class="{panel_cls_accesos(f_tab)}">
            {field_permisos(permisos, f_permisos, locale)}
            {field_skills(skills, f_skills, locale)}
          </div>

          {form_footer_nav(edit_id, f_tab, locale)}
        </form>
      </div>
    </div>
  </template>
}
