// form_helpers.fitz — pure HTML helpers for EmpleadoForm.fitzv.
//
// Separate module to break the cycle (empleados.fitz imports EmpleadoForm, which
// imports these helpers). The SFC is a thin declarative SHELL (form / panels /
// selects / footer); everything the DSL can't express inline lives here as a
// helper that returns raw HTML, interpolated crudely (gotcha #2 — interpolation
// doesn't auto-escape, so a helper returning HTML emits it verbatim).
//
// Moved verbatim from empleados.fitz (option builders, permisos/skills, stepper
// bits) plus new shell helpers (banner / header-nav / footer-nav / panel classes
// / placeholders). `id_checked` is duplicated here (it's also used all over
// empleados.fitz; a copy avoids the import cycle — the plan authorizes it).

from models import Departamento, Pais, Provincia, Ciudad, Permiso, Skill, Empleado
from i18n import t
from fitz_liveviews import Html, flv, html, h_join
from fitz_liveviews.ui.Alert import alert, alert_render
from fitz_liveviews.ui.Button import button, button_render
from fitz_liveviews.ui.Input import input, input_render
from fitz_liveviews.ui.Textarea import textarea, textarea_render
from fitz_liveviews.ui.Select import select, select_render
from fitz_liveviews.ui.RadioGroup import radio_group, radio_group_render
from fitz_liveviews.ui.Rating import rating, rating_render
from fitz_liveviews.ui.CheckboxGroup import checkbox_group, checkbox_group_render
from fitz_liveviews.ui.DatePicker import date_picker, date_picker_render
from fitz_liveviews.ui.GroupSelect import group_select, group_select_render
from fitz_liveviews.ui.MultiSelect import multi_select, multi_select_render
from fitz_liveviews.ui.Tabs import tabs, tabs_render
from fitz_liveviews.ui.Stepper import stepper, stepper_render
from fitz_liveviews.ui.form_input_helpers import FieldOption
from fitz_liveviews.ui.form_layout_helpers import OptionGroup, Tab, Step

// --- set membership (copy of empleados.fitz's; see module header) ------------
fn id_checked(csv: Str, id: Int) -> Bool {
    let hay = "," + csv + ","
    let needle = ",{id},"
    return hay.contains(needle)
}

// --- <option> builders -------------------------------------------------------

// Departamento field — the packaged Select (basic dropdown). Builds a
// `List<FieldOption>` (a "none" head + one per department) and lets Select render
// the labeled `<select>`. Same reason it's a helper (not inline in the SFC): a
// struct literal's braces can't sit inside a `.fitzv` interpolation.
fn field_depto(deptos: List<Departamento>, selected: Int, locale: Str) -> Str {
    let opts: List<FieldOption> = [
        FieldOption { label: t(locale, "form.depto.none"), value: "0", on: selected == 0 },
    ]
    for d in deptos {
        opts.push(FieldOption { label: d.nombre, value: "{d.id}", on: d.id == selected })
    }
    return select_render(select { name: "departamento_id", label: t(locale, "form.depto"), options: opts }).raw
}

// País / provincia / ciudad — the packaged Select in CASCADE mode: `on_change`
// fires a `data-flv-change` fall-through event, the loop re-queries the dependent
// options server-side (the browser sends the picked value as `payload["value"]`).
// Build a `List<FieldOption>` with a "none" head.
fn field_pais(items: List<Pais>, selected: Int, locale: Str) -> Str {
    let opts: List<FieldOption> = [FieldOption { label: "— País —", value: "0", on: selected == 0 }]
    for p in items {
        opts.push(FieldOption { label: p.nombre, value: "{p.id}", on: p.id == selected })
    }
    return select_render(select { name: "pais_id", label: t(locale, "form.pais"), options: opts, on_change: "cascade_pais" }).raw
}

fn field_provincia(items: List<Provincia>, selected: Int, locale: Str) -> Str {
    let opts: List<FieldOption> = [FieldOption { label: "— Provincia —", value: "0", on: selected == 0 }]
    for p in items {
        opts.push(FieldOption { label: p.nombre, value: "{p.id}", on: p.id == selected })
    }
    return select_render(select { name: "provincia_id", label: t(locale, "form.provincia"), options: opts, on_change: "cascade_provincia" }).raw
}

fn field_ciudad(items: List<Ciudad>, selected: Int, locale: Str) -> Str {
    let opts: List<FieldOption> = [FieldOption { label: "— Ciudad —", value: "0", on: selected == 0 }]
    for c in items {
        opts.push(FieldOption { label: c.nombre, value: "{c.id}", on: c.id == selected })
    }
    return select_render(select { name: "ciudad_id", label: t(locale, "form.ciudad"), options: opts, on_change: "cascade_ciudad" }).raw
}

// "Reporta a" — the packaged GroupSelect: colleagues bucketed into `<optgroup>`s
// by department. `self_id` (the row being edited) is excluded so an employee can't
// report to itself. Empty departments are skipped.
fn field_reporta(colegas: List<Empleado>, deptos: List<Departamento>, self_id: Int, selected: Int, locale: Str) -> Str {
    let groups: List<OptionGroup> = []
    for d in deptos {
        let members = colegas.filter(fn(e) => e.departamento_id == d.id and e.id != self_id)
        if (members.len() > 0) {
            let opts: List<FieldOption> = members.map(fn(e) => FieldOption { label: e.nombre, value: "{e.id}", on: e.id == selected })
            groups.push(OptionGroup { label: d.nombre, options: opts })
        }
    }
    return group_select_render(group_select { name: "reporta_a", label: t(locale, "form.reporta"), groups: groups, head_label: t(locale, "form.reporta.none"), head_on: selected == 0 }).raw
}

// --- permisos + skills -------------------------------------------------------

// Permisos — the packaged MultiSelect: one titled `<fieldset>` per module (the
// list arrives ordered by `modulo`), one checkbox per permiso, all sharing
// `name="permisos"`. Buckets the permisos into `List<OptionGroup>` by module.
fn field_permisos(permisos: List<Permiso>, checked_csv: Str, locale: Str) -> Str {
    let groups: List<OptionGroup> = []
    let cur_mod = ""
    let cur_opts: List<FieldOption> = []
    for p in permisos {
        if (p.modulo != cur_mod) {
            if (cur_mod != "") {
                groups.push(OptionGroup { label: cur_mod, options: cur_opts })
            }
            cur_mod = p.modulo
            cur_opts = []
        }
        cur_opts.push(FieldOption { label: p.nombre, value: "{p.id}", on: id_checked(checked_csv, p.id) })
    }
    if (cur_mod != "") {
        groups.push(OptionGroup { label: cur_mod, options: cur_opts })
    }
    return multi_select_render(multi_select { name: "permisos", label: t(locale, "form.permisos"), groups: groups }).raw
}

// Skills field — the packaged CheckboxGroup (chip multiselect; all share
// `name="skills"`). Builds a `List<FieldOption>` from the skills, `on` = ticked.
fn field_skills(skills: List<Skill>, checked_csv: Str, locale: Str) -> Str {
    let opts: List<FieldOption> = skills.map(fn(s) => FieldOption { label: s.nombre, value: "{s.id}", on: id_checked(checked_csv, s.id) })
    return checkbox_group_render(checkbox_group { name: "skills", label: t(locale, "form.skills"), options: opts, chips: true }).raw
}

// --- tabs / stepper / rating -------------------------------------------------

// CSS class for a tab panel — only the active one shows, but ALL panels stay in
// the DOM so the form serializes every field on save regardless of tab. (The tab
// NAV is the packaged Tabs component; the panels stay host-managed here.)
fn tab_panel_cls(val: Str, f_tab: Str) -> Str {
    return match val == f_tab {
        true => "tab-panel tab-active",
        false => "tab-panel",
    }
}

fn step_order(val: Str) -> Int {
    return match val {
        "datos" => 1,
        "org" => 2,
        "accesos" => 3,
        _ => 1,
    }
}

// The Stepper step state for `val` given the active `f_tab`: "done" (behind),
// "active" (current) or "pending" (ahead).
fn step_state(val: Str, f_tab: Str) -> Str {
    let ov = step_order(val)
    let cur = step_order(f_tab)
    return match ov < cur {
        true => "done",
        false => match ov == cur {
            true => "active",
            false => "pending",
        },
    }
}

// The three form sections as a Tab list (edición) / a Step list (alta wizard).
fn form_tab_items(f_tab: Str, locale: Str) -> List<Tab> {
    return [
        Tab { label: t(locale, "form.tab.datos"), value: "datos", active: f_tab == "datos" },
        Tab { label: t(locale, "form.tab.org"), value: "org", active: f_tab == "org" },
        Tab { label: t(locale, "form.tab.accesos"), value: "accesos", active: f_tab == "accesos" },
    ]
}

fn form_step_items(f_tab: Str, locale: Str) -> List<Step> {
    return [
        Step { label: t(locale, "form.tab.datos"), state: step_state("datos", f_tab) },
        Step { label: t(locale, "form.tab.org"), state: step_state("org", f_tab) },
        Step { label: t(locale, "form.tab.accesos"), state: step_state("accesos", f_tab) },
    ]
}

// Desempeño field — the packaged Rating (0-5 star input, pure CSS). The label
// sits in the SFC's form-row; this returns just the stars.
fn field_rating(selected: Int) -> Str => rating_render(rating { name: "nivel", value: selected, max: 5 }).raw

// Estado field — the packaged RadioGroup (activo true/false).
fn field_estado(activo: Bool, locale: Str) -> Str {
    let opts: List<FieldOption> = [
        FieldOption { label: t(locale, "badge.active"), value: "true", on: activo },
        FieldOption { label: t(locale, "badge.inactive"), value: "false", on: not activo },
    ]
    return radio_group_render(radio_group { name: "activo", label: t(locale, "form.estado"), options: opts }).raw
}

// Notas field — the packaged Textarea (multi-line).
fn field_notas(value: Str, locale: Str) -> Str => textarea_render(textarea { name: "notas", label: t(locale, "form.notas"), value: value, placeholder: t(locale, "form.notas.ph"), rows: 3 }).raw

// --- shell fragments (banner / navs / panel classes / placeholders) ----------
//
// The form_html body's dynamic bits, moved out so the SFC template stays
// declarative. Same logic as the old form_html; the SFC interpolates these raw.

// Validation/DB banner ("" when no error). Uses the packaged Alert (danger
// variant); Alert escapes `body` itself, so `error` is passed raw.
fn form_banner(error: Str) -> Str {
    return match error == "" {
        true => "",
        false => alert_render(alert { variant: "danger", body: error }).raw,
    }
}

// Text fields adopt the packaged Input (label + field + hint/error state). Kept
// as helpers (not inline in the SFC template) because a struct literal's braces
// can't sit inside a `.fitzv` interpolation — same reason the <option> builders
// live here (gotcha #2). Input escapes label/value/placeholder itself, so they
// pass raw. `fecha` uses the packaged DatePicker + `notas` the Textarea (below).
fn field_nombre(value: Str, locale: Str) -> Str => input_render(input { name: "nombre", label: t(locale, "form.nombre"), value: value, placeholder: t(locale, "form.nombre.ph"), autocomplete: "off" }).raw
fn field_email(value: Str, locale: Str) -> Str => input_render(input { name: "email", label: t(locale, "form.email"), value: value, input_type: "email", placeholder: "persona@empresa.com", autocomplete: "off" }).raw
fn field_cargo(value: Str, locale: Str) -> Str => input_render(input { name: "cargo", label: t(locale, "form.cargo"), value: value, placeholder: t(locale, "form.cargo.ph"), autocomplete: "off" }).raw
fn field_fecha(value: Str, locale: Str) -> Str => date_picker_render(date_picker { name: "fecha_ingreso", label: t(locale, "form.fecha"), value: value }).raw

// Header nav — alta (edit_id == 0) is the packaged Stepper (guided wizard);
// edición is the packaged Tabs (free navigation). Both are server-tracked.
fn form_header_nav(edit_id: Int, f_tab: Str, locale: Str) -> Str {
    return match edit_id == 0 {
        true => stepper_render(stepper { steps: form_step_items(f_tab, locale) }).raw,
        false => tabs_render(tabs { items: form_tab_items(f_tab, locale) }).raw,
    }
}

// Footer nav — stepper (contextual Back / Next / Finalizar) vs tabs (Save).
fn form_footer_nav(edit_id: Int, f_tab: Str, locale: Str) -> Str {
    let prev_val = match f_tab {
        "org" => "datos",
        "accesos" => "org",
        _ => "",
    }
    let next_val = match f_tab {
        "datos" => "org",
        "org" => "accesos",
        _ => "",
    }
    let back_btn = match prev_val == "" {
        true => "",
        false => """<button type="button" class="btn-clear" data-flv-form data-flv-click="form_tab" data-flv-value-tab="{prev_val}">{t(locale, "form.back")}</button>""",
    }
    let next_btn = match next_val == "" {
        true => "",
        false => """<button type="button" class="btn-primary" data-flv-form data-flv-click="form_tab" data-flv-value-tab="{next_val}">{t(locale, "form.next")}</button>""",
    }
    // Save / Finish / Cancel adopt the packaged Button. Save + Finish are form
    // submits (submit: true → type="submit", drives the enclosing
    // <form data-flv-submit>); Cancel is a plain fall-through click.
    let save_last = match f_tab == "accesos" {
        true => button_render(button { label: t(locale, "form.finish"), variant: "primary", submit: true }).raw,
        false => "",
    }
    let cancel_btn = button_render(button { label: t(locale, "form.cancel"), variant: "secondary", on_click: "cancel_form" }).raw
    let save_btn = button_render(button { label: t(locale, "form.save"), variant: "primary", submit: true }).raw
    return match edit_id == 0 {
        true => """<div class="form-actions">{cancel_btn}{back_btn}{next_btn}{save_last}</div>""",
        false => """<div class="form-actions">{save_btn}{cancel_btn}</div>""",
    }
}

// Panel classes (string-key literal in an attribute → nested-quotes gotcha #1;
// one helper per panel keeps the string arg out of the template).
fn panel_cls_datos(f_tab: Str) -> Str => tab_panel_cls("datos", f_tab)
fn panel_cls_org(f_tab: Str) -> Str => tab_panel_cls("org", f_tab)
fn panel_cls_accesos(f_tab: Str) -> Str => tab_panel_cls("accesos", f_tab)

// Placeholders with i18n (escaped, matching the old `placeholder="{flv(ph)}"`;
// the `t(...)` string-key can't sit inside an attribute — gotcha #1).
fn ph_notas(locale: Str) -> Str => flv(t(locale, "form.notas.ph"))
