// Helper puro para EmpleadoRow.fitzv. Módulo aparte para evitar el ciclo
// (empleados.fitz importa EmpleadoRow). Envuelve lo único que el DSL no expresa
// inline: la clase de fila (necesita un match). Los tooltips i18n vivían acá,
// pero desde fitz core v0.37.17 (comillas dobles anidadas en valores de
// atributo) se interpolan directo en el .fitzv: `data-tooltip="{t(locale, "…")}"`.

fn row_class(checked: Bool, expanded: Bool) -> Str {
    return match checked {
        true => "row-selected",
        false => match expanded {
            true => "row-expanded",
            false => "",
        },
    }
}
