// Fitz LiveViews — ChatRoom SFC, refactored to the companion UI
// library (Phase 9.C). Each message is now a packaged `Card`, and the
// composer row is built from the packaged `Input` and `Button`
// primitives (`submit: true` drives the `data-flv-submit` form, and the
// message field's `clear: true` empties it after each send). The
// primitives come in through thin helper fns in `chat_ui.fitz`, since a
// struct literal inside a `{...}` template interpolation doesn't
// round-trip through the SSR emitter.

from message import Message
from chat_ui import message_bubble, author_input, text_input, send_button
from fitz_liveviews.ui.theme import ui_theme

component ChatRoom {
  state { messages: List<Message> = [] }

  event send_message() {
    if (payload.has("author")) {
      if (payload.has("text")) {
        let author = payload["author"]
        let text = payload["text"]
        messages.push(Message { author: author, text: text })
      }
    }
  }

  <template>
    <div id="chat-app">
      {ui_theme().raw}
      <h1>Fitz LiveViews Chat</h1>
      <ul class="chat-log">
        {#for m in messages}
          <li class="chat-item">{message_bubble(m).raw}</li>
        {/for}
      </ul>
      <form data-flv-submit="send_message" class="chat-form">
        {author_input().raw}
        {text_input().raw}
        {send_button().raw}
      </form>
    </div>
  </template>

  <style scoped>
    #chat-app {
      max-width: 640px;
      margin: 0 auto;
      padding: 1rem;
      font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
      color: var(--flv-text, #222);
    }
    #chat-app h1 { font-size: 1.4rem; color: #CE412B; }
    .chat-log { list-style: none; padding: 0; margin: 0 0 1rem 0; display: flex; flex-direction: column; gap: .5rem; }
    .chat-form { display: flex; gap: .5rem; align-items: flex-end; flex-wrap: wrap; }
    .chat-form > * { flex: 1 1 8rem; }
    .chat-form > .flv-btn-slot { flex: 0 0 auto; }
  </style>
}
