// Fitz LiveViews — real-time counter refactored to the companion UI
// library (Phase 9.C). The three buttons render through the packaged
// `Button` primitive via thin helper fns in `counter_ui.fitz`; each
// `on_click` names a fall-through event that routes to this component's
// matching `@on` handler, exactly like the raw `@click` did.

from counter_ui import inc_button, dec_button, reset_button
from fitz_liveviews.ui.theme import ui_theme

component Counter {
  state { count: Int = 0 }

  event increment() { count = count + 1 }
  event decrement() { count = count - 1 }
  event reset() { count = 0 }

  <template>
    <div id="counter-app">
      {ui_theme().raw}
      <h1>Fitz LiveViews Counter</h1>
      <p>Count: {count}</p>
      {inc_button().raw}
      {dec_button().raw}
      {reset_button().raw}
    </div>
  </template>
}
