// Fitz LiveViews — Board SFC, refactored to the companion UI library
// (Phase 9.C). Each card is now a packaged `Card` with baked-in `Icon`
// action buttons, and the composer row uses the packaged `Input` +
// `Button` primitives (`submit: true` drives the `data-flv-submit`
// form; the title field's `clear: true` empties it after each add).
// The three columns collapsed to one shared `render_card(c)` helper
// (it derives the available move actions from `c.column`), so adding a
// column or an action is a one-line change. Primitives come in through
// `board_ui.fitz` helper fns, since a struct literal inside a `{...}`
// template interpolation doesn't round-trip through the SSR emitter.
//
// Architecture:
//   - `card.fitz`           — shared types (`Card`, `Board`).
//   - `board_helpers.fitz`  — pure column-progression / filter logic.
//   - `board_ui.fitz`       — presentational primitive wrappers.
//   - `Board.fitzv`         — state + events + template.
//   - `main.fitz`           — HTTP GET + WS routes; ZERO business logic.

from card import Card
from board_helpers import cards_in, keep_if_not, move_one, make_card
from board_ui import render_card, title_input, author_input, add_button

component Board {
  state {
    cards: List<Card> = []
    next_id: Int = 1
  }

  event create_card() {
    if (payload.has("title")) {
      if (payload.has("author")) {
        let id_str = "{next_id}"
        let title = payload["title"]
        let author = payload["author"]
        cards.push(make_card(id_str, title, author))
        next_id = next_id + 1
      }
    }
  }

  event move_right() {
    if (payload.has("card_id")) {
      let target_id = payload["card_id"]
      cards = cards.map(fn(c) => move_one(target_id, "right", c))
    }
  }

  event move_left() {
    if (payload.has("card_id")) {
      let target_id = payload["card_id"]
      cards = cards.map(fn(c) => move_one(target_id, "left", c))
    }
  }

  event delete_card() {
    if (payload.has("card_id")) {
      let target_id = payload["card_id"]
      cards = cards.filter(fn(c) => keep_if_not(target_id, c))
    }
  }

  <template>
    <div id="kanban-app">
      <h1>Fitz LiveViews Kanban</h1>
      <p class="sub">Open in two browser windows — actions sync in real time via broadcast patches.</p>
      <form data-flv-submit="create_card" class="add-form">
        {title_input().raw}
        {author_input().raw}
        {add_button().raw}
      </form>
      <div class="board">
        <section class="column">
          <h2>To Do <span class="count">({cards_in(cards, "todo").len()})</span></h2>
          <ul class="card-list">
            {#for c in cards_in(cards, "todo")}
              <li>{render_card(c).raw}</li>
            {/for}
          </ul>
        </section>
        <section class="column">
          <h2>In Progress <span class="count">({cards_in(cards, "in_progress").len()})</span></h2>
          <ul class="card-list">
            {#for c in cards_in(cards, "in_progress")}
              <li>{render_card(c).raw}</li>
            {/for}
          </ul>
        </section>
        <section class="column">
          <h2>Done <span class="count">({cards_in(cards, "done").len()})</span></h2>
          <ul class="card-list">
            {#for c in cards_in(cards, "done")}
              <li>{render_card(c).raw}</li>
            {/for}
          </ul>
        </section>
      </div>
    </div>
  </template>
}
