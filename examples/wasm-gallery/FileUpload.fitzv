// FileUpload.fitzv — client-WASM image upload with preview. `<input
// type="file" data-flv-file="on_file">` reads the picked file via FileReader
// into state as a data URL; the template renders the preview. All client-side,
// no server, no upload.

component FileUpload {
  state {
    img: Str = ""
    name: Str = ""
    has: Bool = false
  }

  event on_file() {
    img = payload["data"]
    name = payload["name"]
    has = true
  }

  event clear() {
    img = ""
    name = ""
    has = false
  }

  <template>
    <div class="up">
      <label class="pick">
        <input type="file" accept="image/*" data-flv-file="on_file" />
        <span class="pick-label">Choose an image…</span>
      </label>
      {#if has}
        <div class="preview">
          <img class="thumb" src="{img}" alt="preview" />
          <div class="meta">
            <span class="fname">{name}</span>
            <button class="clear" @click="clear">Clear</button>
          </div>
        </div>
      {/if}
    </div>
  </template>

  <style scoped>
    .up { width: 280px; max-width: 100%; font-family: system-ui, sans-serif; }
    .pick {
      display: inline-flex; align-items: center; gap: 8px; cursor: pointer;
      padding: 10px 14px; border-radius: 8px;
      background: var(--flv-color-primary, #ce412b); color: #fff; font-weight: 600;
    }
    .pick input { display: none; }
    .preview { margin-top: 14px; border: 1px solid var(--flv-border, #d9d9e0); border-radius: 8px; overflow: hidden; }
    .thumb { width: 100%; height: 180px; object-fit: cover; display: block; }
    .meta { display: flex; align-items: center; justify-content: space-between; padding: 8px 10px; gap: 8px; }
    .fname { font-size: .82rem; color: var(--flv-text-muted, #55555c); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .clear { border: none; background: var(--flv-surface-2, #f5f5f7); color: var(--flv-text, #1a1a1a); border-radius: 6px; padding: 4px 10px; cursor: pointer; }
  </style>
}
