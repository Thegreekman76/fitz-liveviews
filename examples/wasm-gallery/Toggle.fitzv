// Toggle.fitzv — a Bool switch (CW.2). Standalone client component:
// imports nothing, `{...}` interpolation, local `@click`, `--flv-*` look.
//
// Exercises: Bool state and an `{#if}` over a bare state-field ident.
// Note: the `.fitzv` view lexer rejects `!` in event bodies (only `!=`),
// so the flip is expressed as `on = on == false`.

component Toggle {
  state { on: Bool = false }

  event flip() { on = on == false }

  <template>
    <div class="wrap">
      {#if on}
        <button class="switch switch-on" @click="flip">
          <span class="knob knob-on"></span>
        </button>
        <span class="label">Encendido</span>
      {#else}
        <button class="switch" @click="flip">
          <span class="knob"></span>
        </button>
        <span class="label">Apagado</span>
      {/if}
    </div>
  </template>

  <style scoped>
    .wrap {
      display: flex;
      align-items: center;
      gap: 12px;
      font-family: system-ui, sans-serif;
      color: var(--flv-text, #1a1a1a);
    }
    .switch {
      position: relative;
      width: 52px;
      height: 30px;
      border: none;
      border-radius: 999px;
      background: var(--flv-surface-2, #f5f5f7);
      box-shadow: inset 0 0 0 1px var(--flv-border, #d9d9e0);
      cursor: pointer;
      padding: 0;
    }
    .switch-on {
      background: var(--flv-color-primary, #ce412b);
      box-shadow: inset 0 0 0 1px var(--flv-color-primary, #ce412b);
    }
    .knob {
      position: absolute;
      top: 3px;
      left: 3px;
      width: 24px;
      height: 24px;
      border-radius: 50%;
      background: #ffffff;
      box-shadow: 0 1px 3px rgba(0, 0, 0, .3);
    }
    .knob-on {
      left: 25px;
    }
    .label {
      font-weight: 600;
      min-width: 9ch;
    }
  </style>
}
