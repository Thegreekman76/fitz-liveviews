// Carousel.fitzv — client-WASM image carousel. Three SVG slides (base64
// data URIs — self-contained, offline, no external files) shown one at a
// time; prev/next wrap around and the dots jump. Exercises Int state,
// {#if index == N}, if-as-value in event bodies, and <img src>
// attribute interpolation. All client-side, no server.

component Carousel {
  state {
    index: Int = 0
    img0: Str = "data:image/svg+xml;base64,"
    img1: Str = "data:image/svg+xml;base64,"
    img2: Str = "data:image/svg+xml;base64,"
  }

  event next() { index = if (index >= 2) { 0 } else { index + 1 } }
  event prev() { index = if (index <= 0) { 2 } else { index - 1 } }
  event go0() { index = 0 }
  event go1() { index = 1 }
  event go2() { index = 2 }

  <template>
    <div class="carousel">
      <div class="frame">
        {#if index == 0}<img class="slide" src="{img0}" alt="Sunrise over the range" />{/if}
        {#if index == 1}<img class="slide" src="{img1}" alt="Midday peaks" />{/if}
        {#if index == 2}<img class="slide" src="{img2}" alt="Dusk on the summit" />{/if}
        <button class="nav prev" @click="prev" aria-label="Previous slide">&lsaquo;</button>
        <button class="nav next" @click="next" aria-label="Next slide">&rsaquo;</button>
      </div>
      <div class="dots">
        {#if index == 0}<button class="dot on" @click="go0" aria-label="Slide 1"></button>{#else}<button class="dot" @click="go0" aria-label="Slide 1"></button>{/if}
        {#if index == 1}<button class="dot on" @click="go1" aria-label="Slide 2"></button>{#else}<button class="dot" @click="go1" aria-label="Slide 2"></button>{/if}
        {#if index == 2}<button class="dot on" @click="go2" aria-label="Slide 3"></button>{#else}<button class="dot" @click="go2" aria-label="Slide 3"></button>{/if}
      </div>
    </div>
  </template>

  <style scoped>
    .carousel { width: 320px; max-width: 100%; font-family: system-ui, sans-serif; }
    .frame {
      position: relative; border-radius: var(--flv-radius-md, 8px);
      overflow: hidden; border: 1px solid var(--flv-border, #d9d9e0);
      box-shadow: var(--flv-shadow-card, 0 6px 20px rgba(0,0,0,.12));
      line-height: 0;
    }
    .slide { width: 100%; height: 200px; object-fit: cover; display: block; }
    .nav {
      position: absolute; top: 50%; transform: translateY(-50%);
      width: 34px; height: 34px; border-radius: 50%; border: none;
      background: rgba(0,0,0,.45); color: #fff; font-size: 1.4rem;
      cursor: pointer; display: flex; align-items: center; justify-content: center;
    }
    .nav:hover { background: rgba(0,0,0,.65); }
    .prev { left: 8px; }
    .next { right: 8px; }
    .dots { display: flex; gap: 8px; justify-content: center; padding: 12px 0 2px; }
    .dot {
      width: 10px; height: 10px; border-radius: 50%; border: none; cursor: pointer;
      background: var(--flv-border, #d9d9e0); padding: 0;
    }
    .dot.on { background: var(--flv-color-primary, #ce412b); }
  </style>
}
