{
  "name": "fitz-liveviews",
  "displayName": "Fitz LiveViews",
  "description": "Syntax highlighting for Fitz LiveViews: `.fitzv` single-file components (template/state/event/style, hydrate marker) and `html(\"\"\"...\"\"\")` templates in classic `.fitz`.",
  "version": "0.38.0",
  "publisher": "thegreekman76",
  "license": "MIT",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "fitz",
    "fitz-lang",
    "liveview",
    "websocket",
    "reactive-ui",
    "server-rendered"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Thegreekman76/fitz-liveviews.git",
    "directory": "editors/vscode"
  },
  "homepage": "https://github.com/Thegreekman76/fitz-liveviews",
  "bugs": {
    "url": "https://github.com/Thegreekman76/fitz-liveviews/issues"
  },
  "extensionDependencies": [
    "thegreekman76.fitz-language"
  ],
  "contributes": {
    "languages": [
      {
        "id": "fitzv",
        "aliases": [
          "Fitz View",
          "fitzv"
        ],
        "extensions": [
          ".fitzv"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "scopeName": "fitz.liveviews.injection",
        "path": "./syntaxes/fitz-liveviews-injection.json",
        "injectTo": [
          "source.fitz"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.html.fitz": "html"
        }
      },
      {
        "language": "fitzv",
        "scopeName": "source.fitzv",
        "path": "./syntaxes/fitzv.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.html.fitzv": "html",
          "source.css": "css"
        }
      }
    ],
    "snippets": [
      {
        "language": "fitz",
        "path": "./snippets/snippets.json"
      }
    ]
  }
}
