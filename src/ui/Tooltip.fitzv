// Tooltip.fitzv — packaged companion UI primitive (Phase 9, Feedback family).
//
// Presentational / SSR: `tooltip_render(tooltip { ... }).raw`. A CSS-only hover
// tooltip (zero JS) — wraps `content` (raw markup: an icon, a value, a word) and
// shows `tip` in a bubble above it on hover. No state, no events. The
// `:not([data-tip=""])` guard means an empty `tip` renders no bubble. (The Admin
// ABM's icon buttons get the same behavior from the AppShell chrome CSS, which
// styles a global `[data-tooltip]`; this component is the standalone, scoped
// version for apps that don't use AppShell.) Style it by aliasing --flv-* tokens.

from fitz_liveviews import flv

component tooltip {
  state {
    content: Str = ""
    tip: Str = ""
  }

  <template>
    <span class="flv-tooltip" data-tip="{flv(tip)}">{content}</span>
  </template>

  <style scoped>
    .flv-tooltip:not([data-tip=""]) { position: relative; }
    .flv-tooltip:not([data-tip=""])::after {
      content: attr(data-tip); position: absolute; bottom: 100%; left: 50%;
      transform: translateX(-50%) translateY(-4px); white-space: nowrap;
      background: #1e293b; color: #fff; font-size: .72rem; font-weight: 500;
      padding: .25rem .5rem; border-radius: 6px; pointer-events: none;
      opacity: 0; transition: opacity .12s; z-index: 40;
    }
    .flv-tooltip:not([data-tip=""]):hover::after { opacity: 1; }
  </style>
}
