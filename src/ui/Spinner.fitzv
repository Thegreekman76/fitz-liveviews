// Spinner.fitzv — packaged companion UI primitive (Phase 9, corte 2).
//
// Pure presentational / SSR: `spinner_render(spinner { ... }).raw`. No state, no
// events — the parent passes props and re-renders it inline. Two modes:
//   - indeterminate (default, `progress: -1`): a rotating ring.
//   - determinate (`progress: 0..100`): an SVG ring filled to the given percent
//     via the `--flv-p` custom property (no client JS).
// Sizes sm/md/lg; `inline: true` sits it on a text baseline, `false` (default)
// centers it as a block. `label` is a screen-reader-only status string. Style it
// with your own theme by aliasing the --flv-* tokens (see src/ui/theme.fitz).

from fitz_liveviews import flv

component spinner {
  state {
    size: Str = "md"
    label: Str = ""
    inline: Bool = false
    progress: Int = -1
  }

  <template>
    {#if progress < 0}
      <span class="flv-spin" data-size="{size}" data-inline="{inline}" role="status">
        <span class="flv-spin-ring"></span>
        <span class="flv-spin-sr">{flv(label)}</span>
      </span>
    {#else}
      <span class="flv-spin flv-spin-det" data-size="{size}" data-inline="{inline}" role="status" style="--flv-p: {progress}">
        <svg class="flv-spin-svg" viewBox="0 0 36 36">
          <circle class="flv-spin-track" cx="18" cy="18" r="15.9155"></circle>
          <circle class="flv-spin-fill" cx="18" cy="18" r="15.9155"></circle>
        </svg>
        <span class="flv-spin-sr">{flv(label)}</span>
      </span>
    {/if}
  </template>

  <style scoped>
    .flv-spin { display: flex; align-items: center; justify-content: center; }
    .flv-spin[data-inline="true"] { display: inline-flex; vertical-align: middle; }
    .flv-spin-ring {
      display: inline-block; border-radius: 50%;
      border: 3px solid var(--flv-border, #d9d9e0);
      border-top-color: var(--flv-color-primary, #ce412b);
      animation: flv-spin-rotate .7s linear infinite;
    }
    .flv-spin[data-size="sm"] .flv-spin-ring, .flv-spin[data-size="sm"] .flv-spin-svg { width: 1rem; height: 1rem; }
    .flv-spin[data-size="md"] .flv-spin-ring, .flv-spin[data-size="md"] .flv-spin-svg { width: 1.6rem; height: 1.6rem; }
    .flv-spin[data-size="lg"] .flv-spin-ring, .flv-spin[data-size="lg"] .flv-spin-svg { width: 2.4rem; height: 2.4rem; }
    .flv-spin-svg { transform: rotate(-90deg); }
    .flv-spin-track { fill: none; stroke: var(--flv-border, #d9d9e0); stroke-width: 3; }
    .flv-spin-fill {
      fill: none; stroke: var(--flv-color-primary, #ce412b); stroke-width: 3;
      stroke-linecap: round; stroke-dasharray: 100 100;
      stroke-dashoffset: calc((100 - var(--flv-p, 0)) * 1px);
      transition: stroke-dashoffset .3s ease;
    }
    .flv-spin-sr {
      position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
      overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;
    }
    @keyframes flv-spin-rotate { to { transform: rotate(360deg); } }
  </style>
}
