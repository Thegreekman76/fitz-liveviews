// Select.fitzv — packaged companion UI primitive (Phase 9, Forms family).
//
// Presentational / controlled: `select_render(select { ... }).raw`. A labeled
// `<select>` built from a `List<FieldOption>` (each `{ label, value, on }`; `on`
// marks the selected option). Same `.flv-field` label + hint/error shell as Input.
// No state of its own — read the chosen `value` back from the form's
// `data-flv-submit` handler by `name`. Set `on_change` to a fall-through event to
// re-query on change (e.g. a country → province cascade); it fires
// `data-flv-change` and falls through to the host `@ws` loop. `error` switches to
// the invalid style. `<optgroup>` (GroupSelect) is a separate, later component.

from form_input_helpers import FieldOption
from fitz_liveviews import flv

component select {
  state {
    name: Str = ""
    label: Str = ""
    options: List<FieldOption> = []
    hint: Str = ""
    error: Str = ""
    disabled: Bool = false
    on_change: Str = ""
  }

  <template>
    <label class="flv-field">
      {#if label != ""}<span class="flv-field-label">{flv(label)}</span>{/if}
      {#if disabled}
        <select class="flv-field-input flv-field-select" name="{flv(name)}" disabled>
          {#for o in options}
            <option value="{flv(o.value)}" selected={o.on}>{flv(o.label)}</option>
          {/for}
        </select>
      {#else}
        {#if on_change != ""}
          <select class="flv-field-input flv-field-select" name="{flv(name)}" data-flv-change="{on_change}">
            {#for o in options}
              <option value="{flv(o.value)}" selected={o.on}>{flv(o.label)}</option>
            {/for}
          </select>
        {#else}
          <select class="flv-field-input flv-field-select" name="{flv(name)}">
            {#for o in options}
              <option value="{flv(o.value)}" selected={o.on}>{flv(o.label)}</option>
            {/for}
          </select>
        {/if}
      {/if}
      {#if error != ""}
        <span class="flv-field-error">{flv(error)}</span>
      {#else}
        {#if hint != ""}<span class="flv-field-hint">{flv(hint)}</span>{/if}
      {/if}
    </label>
  </template>

  <style scoped>
    .flv-field { display: flex; flex-direction: column; gap: .3rem; }
    .flv-field-label { font-size: .82rem; font-weight: 600; color: var(--flv-text, #1a1a1a); }
    .flv-field-input {
      font-size: .9rem; padding: .5rem .7rem;
      border-radius: var(--flv-radius-md, 8px);
      border: 1px solid var(--flv-border, #d9d9e0);
      background: var(--flv-surface, #ffffff);
      color: var(--flv-text, #1a1a1a);
      font-family: inherit;
      transition: border-color .12s ease, box-shadow .12s ease;
    }
    .flv-field-select { cursor: pointer; }
    .flv-field-input:focus {
      outline: none;
      border-color: var(--flv-color-primary, #ce412b);
      box-shadow: 0 0 0 3px color-mix(in srgb, var(--flv-color-primary, #ce412b) 20%, transparent);
    }
    .flv-field-input:disabled { opacity: .55; cursor: default; background: var(--flv-surface-2, #f5f5f7); }
    .flv-field:has(.flv-field-error) .flv-field-input { border-color: var(--flv-color-danger, #c62828); }
    .flv-field-hint { font-size: .78rem; color: var(--flv-text-muted, #55555c); }
    .flv-field-error { font-size: .78rem; color: var(--flv-color-danger, #c62828); font-weight: 600; }
  </style>
}
