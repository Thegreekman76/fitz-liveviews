// Input.fitzv — packaged companion UI primitive (Phase 9, corte 2).
//
// Presentational / controlled: `input_render(input { ... }).raw`. It has no state
// of its own — its `value` lives in the host's form. Give it a `name` and read it
// back from the form's `data-flv-submit` handler (the standard fitz-liveviews form
// pattern). All user-facing attribute values are escaped. Set `error` to a
// non-empty message to switch to the invalid style (via CSS `:has()`); otherwise
// `hint` shows the helper text. Style it by aliasing the --flv-* tokens (see
// src/ui/theme.fitz); each token carries a literal fallback.

from fitz_liveviews import flv

component input {
  state {
    name: Str = ""
    label: Str = ""
    value: Str = ""
    input_type: Str = "text"
    placeholder: Str = ""
    hint: Str = ""
    error: Str = ""
    disabled: Bool = false
    required: Bool = false
    clear: Bool = false
    autocomplete: Str = ""
  }

  <template>
    <label class="flv-field">
      {#if label != ""}<span class="flv-field-label">{flv(label)}</span>{/if}
      <input class="flv-field-input" name="{flv(name)}" type="{input_type}" value="{flv(value)}" placeholder="{flv(placeholder)}" autocomplete="{autocomplete}" required={required} data-flv-clear={clear} disabled={disabled} />
      {#if error != ""}
        <span class="flv-field-error">{flv(error)}</span>
      {#else}
        {#if hint != ""}<span class="flv-field-hint">{flv(hint)}</span>{/if}
      {/if}
    </label>
  </template>

  <style scoped>
    .flv-field { display: flex; flex-direction: column; gap: .3rem; }
    .flv-field-label { font-size: .82rem; font-weight: 600; color: var(--flv-text, #1a1a1a); }
    .flv-field-input {
      font-size: .9rem; padding: .5rem .7rem;
      border-radius: var(--flv-radius-md, 8px);
      border: 1px solid var(--flv-border, #d9d9e0);
      background: var(--flv-surface, #ffffff);
      color: var(--flv-text, #1a1a1a);
      transition: border-color .12s ease, box-shadow .12s ease;
    }
    .flv-field-input::placeholder { color: var(--flv-text-muted, #55555c); opacity: .8; }
    .flv-field-input:focus {
      outline: none;
      border-color: var(--flv-color-primary, #ce412b);
      box-shadow: 0 0 0 3px color-mix(in srgb, var(--flv-color-primary, #ce412b) 20%, transparent);
    }
    .flv-field-input:disabled { opacity: .55; cursor: default; background: var(--flv-surface-2, #f5f5f7); }
    .flv-field:has(.flv-field-error) .flv-field-input { border-color: var(--flv-color-danger, #c62828); }
    .flv-field:has(.flv-field-error) .flv-field-input:focus {
      box-shadow: 0 0 0 3px color-mix(in srgb, var(--flv-color-danger, #c62828) 20%, transparent);
    }
    .flv-field-hint { font-size: .78rem; color: var(--flv-text-muted, #55555c); }
    .flv-field-error { font-size: .78rem; color: var(--flv-color-danger, #c62828); font-weight: 600; }
  </style>
}
