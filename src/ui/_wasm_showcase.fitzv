// _wasm_showcase.fitzv — live client-WASM showcase of the presentational
// companion UI. Lives in src/ui/ so the wasm cross-file loader resolves each
// component as a sibling; imports use a Capitalized alias because the SFC
// composition heuristic treats only Capitalized tags as child components
// (the library components are declared lowercase). Composes the REAL SSR
// sources with static props via the CW.6 flv passthrough. Bin: `showcase`.
//
// Omitted (client-WASM envelope gaps, still SSR-only): ProgressBar + Spinner
// (mixed attribute interpolation, style="...{x}..."), ThemeToggle (relies on
// an SSR-injected `flvCycleTheme()` global).

from Badge import badge as Badge
from Chip import chip as Chip
from CountBadge import count_badge as CountBadge
from StatCard import stat_card as StatCard
from Tooltip import tooltip as Tooltip
from Checkbox import checkbox as Checkbox
from ExpansionPanel import expansion_panel as ExpansionPanel

component WasmShowcase {
  state { heading: Str = "Companion UI - live" }

  <template>
    <div class="sc">
      <div class="row">
        <Badge label="New" variant="primary" size="md" />
        <Badge label="Live" variant="success" size="md" />
        <Badge label="Beta" variant="warning" size="md" />
        <Chip label="Draft" variant="primary" />
        <CountBadge count="5" max="99" variant="primary" />
      </div>
      <div class="row">
        <StatCard label="Revenue" value="1280" hint="+12% MoM" accent="primary" />
        <StatCard label="Users" value="342" hint="+5% WoW" accent="success" />
      </div>
      <div class="row">
        <Tooltip content="Hover me" tip="A client-WASM tooltip" />
        <Checkbox name="opt" label="Enabled" value="on" />
      </div>
      <div class="row">
        <ExpansionPanel summary="What is this?" body="A presentational SSR component running as WASM." />
      </div>
    </div>
  </template>

  <style scoped>
    .sc { display: flex; flex-direction: column; gap: 16px; padding: 16px; font-family: system-ui, sans-serif; }
    .row { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; }
  </style>
}
